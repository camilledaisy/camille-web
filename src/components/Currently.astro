---
import { currently } from '../site.config';
import { stamp } from '../lib/utils';
---

<aside class="card" aria-labelledby="currently-h">
  <span class="tape" aria-hidden="true"></span>
  <h2 id="currently-h">Currently</h2>
  <p class="meta upd">updated {stamp(new Date(currently.updated))}</p>
  <dl>
    {
      currently.items.map((row) => (
        <div class="row">
          <dt>{row.label}</dt>
          <dd>{row.value}</dd>
        </div>
      ))
    }
  </dl>
</aside>

<style>
  /* an index card: ruled lines and a red margin line */
  .card {
    position: relative;
    background-color: var(--paper-3);
    background-image:
      linear-gradient(90deg, transparent 2.6rem, var(--accent) 2.6rem, var(--accent) calc(2.6rem + 1px), transparent calc(2.6rem + 1px)),
      repeating-linear-gradient(transparent 0 1.7rem, color-mix(in srgb, var(--blue) 22%, transparent) 1.7rem calc(1.7rem + 1px));
    background-position: 0 0, 0 3.9rem;
    padding: 1.1rem 1.2rem 1.4rem 3.3rem;
    box-shadow: var(--shadow);
    border: 1px solid var(--rule);
    transform: rotate(1.4deg);
    transition: transform 0.5s var(--wobble);
  }
  .card:hover {
    transform: rotate(0deg);
  }
  h2 {
    font-size: 2.1rem;
    font-style: italic;
  }
  .upd {
    margin: 0.2rem 0 0.9rem;
    color: var(--accent);
  }
  dl {
    margin: 0;
  }
  .row {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 0.6rem;
    line-height: 1.7rem;
    font-size: 0.98rem;
  }
  dt {
    font-family: var(--f-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-soft);
    padding-top: 0.05rem;
  }
  dd {
    margin: 0;
    line-height: 1.7rem;
  }
  @media (max-width: 500px) {
    .row {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
