---
import { currently } from '../site.config';
import { stamp } from '../lib/utils';
---

<aside class="card" aria-labelledby="currently-h">
  <span class="tape" aria-hidden="true"></span>
  <div class="head">
    <h2 id="currently-h">Currently</h2>
    <p class="meta upd">updated {stamp(new Date(currently.updated))}</p>
  </div>
  <dl>
    {
      currently.items.map((row) => (
        <div class="row">
          <dt>{row.label}</dt>
          <dd>{row.value}</dd>
        </div>
      ))
    }
  </dl>
</aside>

<style>
  /*
   * an index card. every line of text sits on its own ruled line: the rules
   * are drawn behind the list at exactly one line-height apart (--line).
   */
  .card {
    --line: 1.75rem;
    --pad-l: 3.3rem;
    --pad-r: 1.2rem;
    --rule-c: color-mix(in srgb, var(--blue) 24%, transparent);
    position: relative;
    background-color: var(--paper-3);
    /* the margin line */
    background-image: linear-gradient(
      90deg,
      transparent 2.6rem,
      var(--accent) 2.6rem,
      var(--accent) calc(2.6rem + 1px),
      transparent calc(2.6rem + 1px)
    );
    padding: 1.1rem var(--pad-r) 0 var(--pad-l);
    box-shadow: var(--shadow);
    border: 1px solid var(--rule);
    transform: rotate(1.4deg);
    transition: transform 0.5s var(--wobble);
  }
  .card:hover {
    transform: rotate(0deg);
  }
  /* the heading area, closed off by a firmer line like a real index card */
  .head {
    margin: 0 calc(var(--pad-r) * -1) 0 calc(var(--pad-l) * -1);
    padding: 0 var(--pad-r) 0.7rem var(--pad-l);
    border-bottom: 1.5px solid color-mix(in srgb, var(--blue) 55%, transparent);
  }
  h2 {
    font-size: 2.1rem;
    font-style: italic;
  }
  .upd {
    margin: 0.3rem 0 0;
    color: var(--accent);
  }
  dl {
    margin: 0 calc(var(--pad-r) * -1) 0 calc(var(--pad-l) * -1);
    padding: 0 var(--pad-r) var(--line) var(--pad-l);
    background-image: repeating-linear-gradient(
      to bottom,
      transparent 0 calc(var(--line) - 1px),
      var(--rule-c) calc(var(--line) - 1px) var(--line)
    );
  }
  .row {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 0 0.6rem;
    align-items: baseline;
    font-size: 0.98rem;
    line-height: var(--line);
  }
  /* nudge the words down so they sit on their line, like writing on paper */
  dt,
  dd {
    position: relative;
    top: 0.3rem;
  }
  dt {
    font-family: var(--f-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-soft);
    line-height: var(--line);
  }
  dd {
    margin: 0;
    line-height: var(--line);
  }
  @media (max-width: 500px) {
    .row {
      grid-template-columns: 1fr;
    }
  }
</style>
