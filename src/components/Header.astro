---
import { nav, site } from '../site.config';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const crumb = path === '/' ? '' : path.split('/').filter(Boolean)[0];
---

<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="home bare" data-cursor="go home">
      <span class="flower" aria-hidden="true">✿</span>
      <span class="who">{site.name.toLowerCase()}’s corner</span>{crumb && <span class="crumb" aria-hidden="true">/{crumb}</span>}
    </a>

    <nav aria-label="Main">
      <ul>
        {
          nav.map((item, i) => (
            <li class={isActive(item.href) ? 'on' : undefined}>
              <a
                href={item.href}
                class="swap bare"
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                <span>
                  <span class="n" aria-hidden="true">
                    0{i}
                  </span>
                  {item.label}
                </span>
                <span aria-hidden="true">{item.alt}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="tools">
      <span class="clock meta" data-clock data-tz={site.timezone} title="my local time">
        --:--
      </span>
      <button class="theme meta" type="button" data-theme-toggle aria-label="Toggle dark mode">
        <span aria-hidden="true">☾</span> lights
      </button>
    </div>
  </div>
  <div class="wrap" aria-hidden="true">
    <div class="edge">{'·—'.repeat(160)}</div>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    padding-top: 1rem;
  }
  .bar {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    gap: 1rem 2rem;
  }
  .home {
    font-family: var(--f-display);
    font-size: 1.55rem;
    font-style: italic;
    white-space: nowrap;
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
  }
  .flower {
    color: var(--accent);
    font-style: normal;
    display: inline-block;
    transition: transform 0.8s var(--wobble);
  }
  .home:hover .flower {
    transform: rotate(144deg) scale(1.15);
  }
  .crumb {
    font-family: var(--f-mono);
    font-style: normal;
    font-size: 0.8rem;
    color: var(--ink-faint);
  }
  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem clamp(0.8rem, 2vw, 2rem);
  }
  nav li {
    position: relative;
  }
  nav a {
    font-size: 1.05rem;
    padding: 0.1rem 0.15rem;
  }
  .n {
    font-family: var(--f-mono);
    font-size: 0.6rem;
    vertical-align: super;
    color: var(--ink-faint);
    margin-right: 0.15rem;
  }
  /* a hand-drawn circle around the current page */
  nav li.on::after {
    content: '';
    position: absolute;
    inset: -0.45rem -0.7rem -0.35rem -0.6rem;
    border: 1.5px solid var(--blue);
    border-radius: 52% 48% 55% 45% / 60% 45% 55% 40%;
    transform: rotate(-3deg);
    pointer-events: none;
  }
  .tools {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    white-space: nowrap;
  }
  .theme {
    background: none;
    border: 0;
    padding: 0;
    color: var(--ink-soft);
  }
  .theme:hover {
    color: var(--accent);
  }
  .edge {
    font-family: var(--f-mono);
    font-size: 0.7rem;
    color: var(--ink-faint);
    overflow: hidden;
    white-space: nowrap;
    margin-top: 0.6rem;
    user-select: none;
  }
  @media (max-width: 860px) {
    .bar {
      grid-template-columns: 1fr auto;
    }
    nav {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    nav ul {
      justify-content: flex-start;
    }
    .clock {
      display: none;
    }
  }
</style>
