---
import { getCollection } from 'astro:content';
import { hash, inFileOrder, tilt } from '../lib/utils';
import raw from '../data/scrapbook.yaml?raw';

const items = inFileOrder(await getCollection('scrapbook'), raw);
const spans: Record<string, number> = { image: 3, quote: 4, link: 3, note: 2, swatch: 2, ticket: 4, mix: 5, sticker: 2, fortune: 3 };

/**
 * A YouTube link → the pieces needed for a click-to-play embed. Nothing loads
 * from YouTube (beyond the cover picture) until someone presses play.
 */
const youtube = (href = '') => {
  try {
    const u = new URL(href);
    const id = u.hostname.includes('youtu.be') ? u.pathname.slice(1) : u.searchParams.get('v') ?? '';
    const list = u.searchParams.get('list');
    const params = new URLSearchParams({ autoplay: '1', rel: '0' });
    if (list) params.set('list', list);
    return {
      thumb: `https://i.ytimg.com/vi/${id}/hqdefault.jpg`,
      embed: `https://www.youtube-nocookie.com/embed/${id}?${params}`,
    };
  } catch {
    return null;
  }
};
const host = (href = '') => {
  try {
    return new URL(href).hostname.replace(/^www\./, '');
  } catch {
    return href;
  }
};
---

<div class="board" id="scrapbook-board">
  {
    items.map(({ id, data }) => {
      const style = `--span:${spans[data.kind]};--rot:${tilt(id, 4)}deg;--dy:${Math.round(hash(id + 'y') * 40 - 10)}px;--dx:${Math.round(hash(id + 'x') * 20 - 10)}px`;
      return (
        <div class={`bit ${data.kind}`} style={style}>
          {data.kind === 'image' && (
            <figure class="photo">
              <span class="tape" aria-hidden="true" />
              <img src={data.src} alt={data.caption ?? ''} loading="lazy" width="600" height="750" />
              {data.caption && <figcaption>{data.caption}</figcaption>}
            </figure>
          )}
          {data.kind === 'quote' && (
            <blockquote>
              <p>“{data.text}”</p>
              {data.caption && <cite class="meta">— {data.caption}</cite>}
            </blockquote>
          )}
          {data.kind === 'link' && (
            <a href={data.href} class="bare label" data-cursor="visit ↗" rel="noopener">
              <span class="lt">{data.text} ↗</span>
              <span class="meta">{data.caption ?? host(data.href)}</span>
            </a>
          )}
          {data.kind === 'mix' &&
            (() => {
              const yt = youtube(data.href);
              return (
                <div class="mix">
                  <div class="mix-screen" data-yt={yt?.embed} data-yt-title={data.text}>
                    <button type="button" class="mix-play" data-cursor="play ▶" aria-label={`Play: ${data.text} (loads YouTube)`}>
                      {yt && <img src={yt.thumb} alt="" loading="lazy" width="480" height="360" onerror="this.remove()" />}
                      <span class="mix-btn" aria-hidden="true">
                        ▶
                      </span>
                    </button>
                  </div>
                  <div class="mix-label">
                    <span class="meta">side a · on repeat</span>
                    <span class="mix-t">{data.text}</span>
                    <a href={data.href} class="meta mix-open" rel="noopener">
                      {data.caption ?? 'open on youtube'} ↗
                    </a>
                  </div>
                </div>
              );
            })()}
          {data.kind === 'fortune' && (
            <div class="fortune" data-fortune={JSON.stringify(data.fortunes)}>
              <button type="button" class="cookie-btn" aria-expanded="false" data-cursor="crack it">
                <span class="sr-only">Open the fortune cookie</span>
                <svg class="cookie" viewBox="0 0 200 124" aria-hidden="true">
                  <g class="half left">
                    <path class="shell" d="M100 14 C 52 12, 10 46, 10 88 C 10 98, 16 104, 26 108 C 44 96, 76 92, 100 106 Z" />
                    <path class="pleat" d="M100 106 C 88 78, 70 62, 46 56 C 60 72, 72 88, 76 98" />
                    <circle cx="42" cy="34" r="1.5" /><circle cx="28" cy="66" r="1.3" /><circle cx="64" cy="26" r="1.2" />
                  </g>
                  <g class="half right">
                    <path class="shell" d="M100 14 C 148 12, 190 46, 190 88 C 190 98, 184 104, 174 108 C 156 96, 124 92, 100 106 Z" />
                    <path class="pleat" d="M100 106 C 112 78, 130 62, 154 56 C 140 72, 128 88, 124 98" />
                    <circle cx="158" cy="34" r="1.5" /><circle cx="172" cy="66" r="1.3" /><circle cx="136" cy="26" r="1.2" />
                  </g>
                </svg>
              </button>
              <p class="slip" aria-live="polite">
                <span class="slip-text" />
                <span class="slip-nums meta" aria-hidden="true" />
              </p>
              <span class="scribble cookie-hint" aria-hidden="true">
                {data.caption ?? 'crack me open'}
              </span>
            </div>
          )}
          {data.kind === 'sticker' && (
            <figure class="sticker">
              <img src={data.src} alt={data.alt ?? ''} loading="lazy" />
              {data.caption && <figcaption class="scribble">{data.caption}</figcaption>}
            </figure>
          )}
          {data.kind === 'note' && (
            <p class="sticky">
              {data.caption && <span class="meta sticky-label">{data.caption}</span>}
              {data.text}
            </p>
          )}
          {data.kind === 'swatch' && (
            <div class="chip">
              <span class="c" style={`background:${data.color}`} />
              <span class="meta">{data.color}</span>
              <span class="ct">{data.text}</span>
            </div>
          )}
          {data.kind === 'ticket' && (
            <div class="stub">
              <span class="meta">no. {String(Math.floor(hash(id) * 90000) + 10000)}</span>
              <span class="tt">{data.text}</span>
              {data.caption && <span class="scribble">{data.caption}</span>}
            </div>
          )}
        </div>
      );
    })
  }
</div>

<style>
  .board {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-flow: dense;
    gap: 2.2rem var(--gutter);
    align-items: start;
    padding-block: 1rem 2rem;
  }
  .bit {
    grid-column: span var(--span);
    transform: translate(var(--dx), var(--dy)) rotate(var(--rot));
    transition: transform 0.5s var(--wobble);
    position: relative;
  }
  .bit:hover,
  .bit:focus-within {
    transform: translate(var(--dx), calc(var(--dy) - 6px)) rotate(0deg) scale(1.03);
    z-index: 5;
  }

  blockquote {
    margin: 0;
    background: var(--paper-3);
    padding: 1.4rem 1.4rem 2rem;
    box-shadow: var(--shadow);
    /* torn bottom edge */
    clip-path: polygon(0 0, 100% 0, 100% 92%, 94% 97%, 87% 93%, 79% 99%, 70% 94%, 61% 98%, 52% 93%, 43% 99%, 34% 94%, 25% 98%, 16% 93%, 8% 99%, 0 94%);
  }
  blockquote p {
    font-family: var(--f-display);
    font-style: italic;
    font-size: 1.75rem;
    line-height: 1.1;
    margin-bottom: 0.8rem;
  }
  cite {
    font-style: normal;
  }

  /* label-maker strip */
  .label {
    display: block;
    background: var(--ink);
    color: var(--paper);
    padding: 0.8rem 1rem;
    box-shadow: var(--shadow);
  }
  .label .lt {
    display: block;
    font-family: var(--f-mono);
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    line-height: 1.35;
    text-shadow: 0 1px 0 rgb(255 255 255 / 0.15);
  }
  .label .meta {
    color: var(--highlight);
    display: block;
    margin-top: 0.5rem;
    text-transform: none;
  }
  .label:hover .lt {
    text-decoration: underline wavy var(--accent) 1px;
    text-underline-offset: 0.3em;
  }

  /* mixtape: a little screen + a cassette-style label */
  .mix {
    background: var(--ink);
    padding: 10px 10px 0;
    box-shadow: var(--shadow);
  }
  .mix-screen {
    aspect-ratio: 16 / 9;
    background: #000;
    overflow: hidden;
  }
  .mix-screen :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  .mix-play {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: #111;
  }
  .mix-play img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.85;
    filter: saturate(0.85);
    transition: opacity 0.3s;
  }
  .mix-btn {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 3.4rem;
    height: 3.4rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    padding-left: 0.2rem;
    font-size: 1.2rem;
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--paper) 35%, transparent);
    transition: transform 0.35s var(--wobble);
  }
  .mix-play:hover img,
  .mix-play:focus-visible img {
    opacity: 1;
  }
  .mix-play:hover .mix-btn,
  .mix-play:focus-visible .mix-btn {
    transform: scale(1.12);
  }
  .mix-label {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin: 10px -10px 0;
    padding: 0.7rem 1rem 0.8rem;
    background-color: var(--paper-3);
    background-image: repeating-linear-gradient(
      transparent 0 1.55rem,
      color-mix(in srgb, var(--blue) 20%, transparent) 1.55rem calc(1.55rem + 1px)
    );
    border-top: 4px solid var(--accent);
  }
  .mix-label .meta {
    color: var(--ink-soft);
  }
  .mix-t {
    font-family: var(--f-hand);
    font-size: 1.5rem;
    line-height: 1.1;
    color: var(--blue);
  }
  .mix-open {
    align-self: flex-end;
    text-transform: none;
    letter-spacing: 0.02em;
  }

  /* fortune cookie: two halves that swing apart and a paper slip that slides out */
  .fortune {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 0.5rem;
  }
  .cookie-btn {
    all: unset;
    cursor: pointer;
    width: min(100%, 13rem);
    position: relative;
    z-index: 2;
  }
  .cookie-btn:focus-visible {
    outline: 2px dashed var(--accent);
    outline-offset: 6px;
  }
  .cookie {
    width: 100%;
    height: auto;
    overflow: visible;
    filter: drop-shadow(2px 4px 3px rgb(0 0 0 / 0.18));
  }
  .cookie .shell {
    fill: #e9bb68;
    stroke: #b27f30;
    stroke-width: 2;
    stroke-linejoin: round;
  }
  .cookie .pleat {
    fill: #d9a24f;
    stroke: #b27f30;
    stroke-width: 1.6;
    stroke-linejoin: round;
  }
  .cookie circle {
    fill: #c4893a;
  }
  .cookie .half {
    transform-box: view-box;
    transform-origin: 100px 110px;
    transition: transform 0.6s var(--wobble);
  }
  .cookie-btn:hover .half.left {
    transform: rotate(-3deg);
  }
  .cookie-btn:hover .half.right {
    transform: rotate(3deg);
  }
  .fortune.open .half.left {
    transform: translate(-16px, -4px) rotate(-18deg);
  }
  .fortune.open .half.right {
    transform: translate(16px, -4px) rotate(18deg);
  }
  .slip {
    position: relative;
    z-index: 1;
    margin: 0.2rem 0 0;
    width: min(112%, 16rem);
    padding: 0.7rem 0.9rem 0.55rem;
    background: #fbfaf4;
    color: #1a2117;
    border: 1px solid rgb(0 0 0 / 0.08);
    box-shadow: 0 2px 4px rgb(0 0 0 / 0.12);
    text-align: center;
    transform: scaleX(0.05) translateY(-2.5rem);
    opacity: 0;
    transition:
      transform 0.55s var(--wobble) 0.15s,
      opacity 0.2s 0.15s;
  }
  .fortune.open .slip {
    transform: rotate(-2deg) translateY(0.4rem);
    opacity: 1;
  }
  .slip-text {
    display: block;
    font-family: var(--f-body);
    font-size: 0.98rem;
    line-height: 1.35;
  }
  .slip-nums {
    display: block;
    margin-top: 0.4rem;
    color: #b0452f;
    font-size: 0.62rem;
    letter-spacing: 0.14em;
  }
  .cookie-hint {
    position: absolute;
    top: calc(min(100%, 13rem) * 0.62 + 0.9rem);
    margin: 0;
    font-size: 1.2rem;
    transition: opacity 0.3s;
  }
  .fortune.open .cookie-hint {
    opacity: 0;
  }

  /* die-cut vinyl sticker: a white outline hugging the shape + a soft shadow */
  .sticker {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .sticker img {
    width: min(100%, 11rem);
    height: auto;
    filter: drop-shadow(3px 0 0 #fff) drop-shadow(-3px 0 0 #fff) drop-shadow(0 3px 0 #fff) drop-shadow(0 -3px 0 #fff)
      drop-shadow(2px 4px 3px rgb(0 0 0 / 0.18));
    transition: transform 0.45s var(--wobble);
  }
  .bit:hover .sticker img {
    transform: rotate(-6deg) scale(1.04);
  }
  .sticker figcaption {
    margin-top: 0.4rem;
    font-size: 1.2rem;
  }

  .sticky {
    margin: 0;
    background: var(--sticky);
    color: var(--ink);
    aspect-ratio: 1;
    padding: 1rem;
    font-family: var(--f-hand);
    font-size: 1.5rem;
    line-height: 1.1;
    box-shadow:
      var(--shadow),
      inset 0 -18px 18px -18px rgb(0 0 0 / 0.2);
  }

  .sticky-label {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.5rem;
    color: var(--accent);
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.12em;
  }
  /* a little empty checkbox — still to do */
  .sticky-label::before {
    content: '';
    width: 0.8rem;
    height: 0.8rem;
    border: 1.5px solid currentColor;
    border-radius: 2px;
  }

  .chip {
    display: flex;
    flex-direction: column;
    background: var(--paper-3);
    padding: 8px 8px 12px;
    border: 1px solid var(--rule);
    box-shadow: var(--shadow);
  }
  .chip .c {
    aspect-ratio: 1;
    margin-bottom: 0.6rem;
  }
  .ct {
    font-size: 0.9rem;
    line-height: 1.3;
    margin-top: 0.2rem;
  }

  /* ticket stub with punched edges */
  .stub {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.1rem 1.6rem;
    background: color-mix(in srgb, var(--blue) 12%, var(--paper-3));
    border: 1.5px dashed color-mix(in srgb, var(--blue) 70%, transparent);
    mask: radial-gradient(circle 10px at 0 50%, transparent 98%, #000) left / 51% 100% no-repeat,
      radial-gradient(circle 10px at 100% 50%, transparent 98%, #000) right / 51% 100% no-repeat;
    box-shadow: var(--shadow);
  }
  .tt {
    font-family: var(--f-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 1rem;
    line-height: 1.35;
  }
  .stub .scribble {
    align-self: flex-end;
    font-size: 1.3rem;
  }

  @media (max-width: 1000px) {
    .board {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
    .bit {
      grid-column: span 3;
    }
    .note,
    .swatch {
      grid-column: span 2;
    }
  }
  @media (max-width: 560px) {
    .board {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.6rem 1rem;
    }
    .bit {
      grid-column: span 2;
    }
    .note,
    .swatch {
      grid-column: span 1;
    }
  }
</style>
