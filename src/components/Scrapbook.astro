---
import { getCollection } from 'astro:content';
import { hash, inFileOrder, tilt } from '../lib/utils';
import raw from '../data/scrapbook.yaml?raw';

const items = inFileOrder(await getCollection('scrapbook'), raw);
const spans: Record<string, number> = { image: 3, quote: 4, link: 3, note: 2, swatch: 2, ticket: 4, mix: 5, sticker: 2, folder: 4 };

/**
 * A YouTube link → the pieces needed for a click-to-play embed. Nothing loads
 * from YouTube (beyond the cover picture) until someone presses play.
 */
const youtube = (href = '') => {
  try {
    const u = new URL(href);
    const id = u.hostname.includes('youtu.be') ? u.pathname.slice(1) : u.searchParams.get('v') ?? '';
    const list = u.searchParams.get('list');
    const params = new URLSearchParams({ autoplay: '1', rel: '0' });
    if (list) params.set('list', list);
    return {
      thumb: `https://i.ytimg.com/vi/${id}/hqdefault.jpg`,
      embed: `https://www.youtube-nocookie.com/embed/${id}?${params}`,
    };
  } catch {
    return null;
  }
};
const host = (href = '') => {
  try {
    return new URL(href).hostname.replace(/^www\./, '');
  } catch {
    return href;
  }
};
---

<div class="board" id="scrapbook-board">
  {
    items.map(({ id, data }) => {
      const style = `--span:${spans[data.kind]};--rot:${tilt(id, 4)}deg;--dy:${Math.round(hash(id + 'y') * 40 - 10)}px;--dx:${Math.round(hash(id + 'x') * 20 - 10)}px`;
      return (
        <div class={`bit ${data.kind}`} style={style}>
          {data.kind === 'image' && (
            <figure class="photo">
              <span class="tape" aria-hidden="true" />
              <img src={data.src} alt={data.caption ?? ''} loading="lazy" width="600" height="750" />
              {data.caption && <figcaption>{data.caption}</figcaption>}
            </figure>
          )}
          {data.kind === 'quote' && (
            <blockquote>
              <p>“{data.text}”</p>
              {data.caption && <cite class="meta">— {data.caption}</cite>}
            </blockquote>
          )}
          {data.kind === 'link' && (
            <a href={data.href} class="bare label" data-cursor="visit ↗" rel="noopener">
              <span class="lt">{data.text} ↗</span>
              <span class="meta">{data.caption ?? host(data.href)}</span>
            </a>
          )}
          {data.kind === 'mix' &&
            (() => {
              const yt = youtube(data.href);
              return (
                <div class="mix">
                  <div class="mix-screen" data-yt={yt?.embed} data-yt-title={data.text}>
                    <button type="button" class="mix-play" data-cursor="play ▶" aria-label={`Play: ${data.text} (loads YouTube)`}>
                      {yt && <img src={yt.thumb} alt="" loading="lazy" width="480" height="360" onerror="this.remove()" />}
                      <span class="mix-btn" aria-hidden="true">
                        ▶
                      </span>
                    </button>
                  </div>
                  <div class="mix-label">
                    <span class="meta">side a · on repeat</span>
                    <span class="mix-t">{data.text}</span>
                    <a href={data.href} class="meta mix-open" rel="noopener">
                      {data.caption ?? 'open on youtube'} ↗
                    </a>
                  </div>
                </div>
              );
            })()}
          {data.kind === 'folder' && (
            <div class="fldr" data-folder>
              <span class="folder-back" aria-hidden="true">
                <span class="folder-tab" />
              </span>
              <span class="folder-photos" role="list" aria-label={data.text ?? 'photos'}>
                {data.photos.map((ph, i) => (
                  <img
                    role="listitem"
                    src={ph.src}
                    alt={ph.alt}
                    loading="lazy"
                    style={`--i:${i};--mid:${(data.photos.length - 1) / 2}`}
                  />
                ))}
              </span>
              <button
                type="button"
                class="folder-btn"
                aria-expanded="false"
                data-cursor="peek inside"
                aria-label={`Open the ${data.text ?? 'photos'} folder`}
              >
                <span class="folder-front" aria-hidden="true">
                  <span class="folder-name">{data.text ?? 'photos'}</span>
                  <span class="folder-label">{data.caption ?? `${data.photos.length} photos`}</span>
                </span>
              </button>
            </div>
          )}
          {data.kind === 'sticker' && (
            <figure class="sticker">
              <img src={data.src} alt={data.alt ?? ''} loading="lazy" />
              {data.caption && <figcaption class="scribble">{data.caption}</figcaption>}
            </figure>
          )}
          {data.kind === 'note' && (
            <p class="sticky">
              {data.caption && <span class="meta sticky-label">{data.caption}</span>}
              {data.text}
            </p>
          )}
          {data.kind === 'swatch' && (
            <div class="chip">
              <span class="c" style={`background:${data.color}`} />
              <span class="meta">{data.color}</span>
              <span class="ct">{data.text}</span>
            </div>
          )}
          {data.kind === 'ticket' && (
            <div class="stub">
              <span class="meta">no. {String(Math.floor(hash(id) * 90000) + 10000)}</span>
              <span class="tt">{data.text}</span>
              {data.caption && <span class="scribble">{data.caption}</span>}
            </div>
          )}
        </div>
      );
    })
  }
</div>

<style>
  .board {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-flow: dense;
    gap: 2.2rem var(--gutter);
    align-items: start;
    padding-block: 1rem 2rem;
  }
  .bit {
    grid-column: span var(--span);
    transform: translate(var(--dx), var(--dy)) rotate(var(--rot));
    transition: transform 0.5s var(--wobble);
    position: relative;
  }
  .bit:hover,
  .bit:focus-within {
    transform: translate(var(--dx), calc(var(--dy) - 6px)) rotate(0deg) scale(1.03);
    z-index: 5;
  }

  blockquote {
    margin: 0;
    background: var(--paper-3);
    padding: 1.4rem 1.4rem 2rem;
    box-shadow: var(--shadow);
    /* torn bottom edge */
    clip-path: polygon(0 0, 100% 0, 100% 92%, 94% 97%, 87% 93%, 79% 99%, 70% 94%, 61% 98%, 52% 93%, 43% 99%, 34% 94%, 25% 98%, 16% 93%, 8% 99%, 0 94%);
  }
  blockquote p {
    font-family: var(--f-display);
    font-style: italic;
    font-size: 1.75rem;
    line-height: 1.1;
    margin-bottom: 0.8rem;
  }
  cite {
    font-style: normal;
  }

  /* label-maker strip */
  .label {
    display: block;
    background: var(--ink);
    color: var(--paper);
    padding: 0.8rem 1rem;
    box-shadow: var(--shadow);
  }
  .label .lt {
    display: block;
    font-family: var(--f-mono);
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    line-height: 1.35;
    text-shadow: 0 1px 0 rgb(255 255 255 / 0.15);
  }
  .label .meta {
    color: var(--highlight);
    display: block;
    margin-top: 0.5rem;
    text-transform: none;
  }
  .label:hover .lt {
    text-decoration: underline wavy var(--accent) 1px;
    text-underline-offset: 0.3em;
  }

  /* mixtape: a little screen + a cassette-style label */
  .mix {
    background: var(--ink);
    padding: 10px 10px 0;
    box-shadow: var(--shadow);
  }
  .mix-screen {
    aspect-ratio: 16 / 9;
    background: #000;
    overflow: hidden;
  }
  .mix-screen :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  .mix-play {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: #111;
  }
  .mix-play img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.85;
    filter: saturate(0.85);
    transition: opacity 0.3s;
  }
  .mix-btn {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 3.4rem;
    height: 3.4rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    padding-left: 0.2rem;
    font-size: 1.2rem;
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--paper) 35%, transparent);
    transition: transform 0.35s var(--wobble);
  }
  .mix-play:hover img,
  .mix-play:focus-visible img {
    opacity: 1;
  }
  .mix-play:hover .mix-btn,
  .mix-play:focus-visible .mix-btn {
    transform: scale(1.12);
  }
  .mix-label {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin: 10px -10px 0;
    padding: 0.7rem 1rem 0.8rem;
    background-color: var(--paper-3);
    background-image: repeating-linear-gradient(
      transparent 0 1.55rem,
      color-mix(in srgb, var(--blue) 20%, transparent) 1.55rem calc(1.55rem + 1px)
    );
    border-top: 4px solid var(--accent);
  }
  .mix-label .meta {
    color: var(--ink-soft);
  }
  .mix-t {
    font-family: var(--f-hand);
    font-size: 1.5rem;
    line-height: 1.1;
    color: var(--blue);
  }
  .mix-open {
    align-self: flex-end;
    text-transform: none;
    letter-spacing: 0.02em;
  }

  /* a manila folder; photos fan out of it on hover / focus / tap */
  .fldr {
    --manila: #e3c77e;
    --manila-dark: #cfae5c;
    position: relative;
    margin-top: 2.5rem;
    aspect-ratio: 5 / 3.4;
    transition: margin-top 0.5s var(--wobble);
  }
  /* on phones, make room above the folder when it opens so the photos don't cover the mix */
  @media (max-width: 560px) {
    .fldr.open {
      margin-top: 11rem;
    }
  }
  .folder-btn {
    all: unset;
    position: absolute;
    inset: 0;
    cursor: pointer;
  }
  .folder-btn:focus-visible {
    outline: 2px dashed var(--accent);
    outline-offset: 6px;
  }
  .folder-back {
    position: absolute;
    inset: 12% 0 0 0;
    background: var(--manila-dark);
    border-radius: 4px 6px 4px 4px;
    box-shadow: var(--shadow);
  }
  .folder-tab {
    position: absolute;
    left: 0;
    bottom: calc(100% - 1px);
    width: 34%;
    height: 1.3rem;
    background: var(--manila-dark);
    border-radius: 6px 6px 0 0;
  }
  .folder-name {
    margin-right: auto;
    font-family: var(--f-hand);
    font-size: 1.6rem;
    line-height: 1;
    color: #3b2f12;
  }
  .folder-photos {
    z-index: 1;
    position: absolute;
    inset: 18% 8% 14% 8%;
  }
  .folder-photos img {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 5px solid #fbfaf4;
    box-shadow: 0 2px 6px rgb(0 0 0 / 0.2);
    /* closed: stacked, a little crooked, peeking out of the top */
    transform: translateY(calc(var(--i) * -5% - 4%)) rotate(calc((var(--i) - var(--mid)) * 3deg));
    transition: transform 0.55s var(--wobble);
    transition-delay: calc(var(--i) * 40ms);
  }
  .folder-front {
    z-index: 2;
    position: absolute;
    inset: 34% -1% -1% -1%;
    background: var(--manila);
    border-radius: 3px 3px 5px 5px;
    box-shadow: 0 -2px 6px rgb(0 0 0 / 0.12);
    transform-origin: bottom center;
    transition: transform 0.5s var(--wobble);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.6rem;
    padding: 0.7rem 0.9rem;
  }
  .folder-label {
    font-family: var(--f-mono);
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #5a4a1f;
    border: 1px solid currentColor;
    padding: 0.1rem 0.4rem;
  }
  /* open: the front tips forward and the photos fan out above */
  .fldr:hover .folder-front,
  .fldr.open .folder-front,
  .fldr:focus-within .folder-front {
    transform: perspective(600px) rotateX(-38deg);
  }
  .fldr:hover .folder-photos img,
  .fldr.open .folder-photos img,
  .fldr:has(.folder-btn:focus-visible) .folder-photos img {
    transform: translate(calc((var(--i) - var(--mid)) * 46%), calc(-92% + (var(--i) - var(--mid)) * (var(--i) - var(--mid)) * 10%))
      rotate(calc((var(--i) - var(--mid)) * 9deg)) scale(0.8);
  }
  .fldr.open .folder-photos img:hover,
  .fldr:hover .folder-photos img:hover {
    z-index: 3;
    transform: translate(calc((var(--i) - var(--mid)) * 46%), -100%) rotate(0deg) scale(0.95);
  }
  /* the scrapbook tilt makes fanned photos look odd; keep the folder straighter */
  .folder-bit {
    --rot: 1deg !important;
  }

  /* die-cut vinyl sticker: a white outline hugging the shape + a soft shadow */
  .sticker {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .sticker img {
    width: min(100%, 11rem);
    height: auto;
    filter: drop-shadow(3px 0 0 #fff) drop-shadow(-3px 0 0 #fff) drop-shadow(0 3px 0 #fff) drop-shadow(0 -3px 0 #fff)
      drop-shadow(2px 4px 3px rgb(0 0 0 / 0.18));
    transition: transform 0.45s var(--wobble);
  }
  .bit:hover .sticker img {
    transform: rotate(-6deg) scale(1.04);
  }
  .sticker figcaption {
    margin-top: 0.4rem;
    font-size: 1.2rem;
  }

  .sticky {
    margin: 0;
    background: var(--sticky);
    color: var(--ink);
    aspect-ratio: 1;
    padding: 1rem;
    font-family: var(--f-hand);
    font-size: 1.5rem;
    line-height: 1.1;
    box-shadow:
      var(--shadow),
      inset 0 -18px 18px -18px rgb(0 0 0 / 0.2);
  }

  .sticky-label {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.5rem;
    color: var(--accent);
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.12em;
  }
  /* a little empty checkbox — still to do */
  .sticky-label::before {
    content: '';
    width: 0.8rem;
    height: 0.8rem;
    border: 1.5px solid currentColor;
    border-radius: 2px;
  }

  .chip {
    display: flex;
    flex-direction: column;
    background: var(--paper-3);
    padding: 8px 8px 12px;
    border: 1px solid var(--rule);
    box-shadow: var(--shadow);
  }
  .chip .c {
    aspect-ratio: 1;
    margin-bottom: 0.6rem;
  }
  .ct {
    font-size: 0.9rem;
    line-height: 1.3;
    margin-top: 0.2rem;
  }

  /* ticket stub with punched edges */
  .stub {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.1rem 1.6rem;
    background: color-mix(in srgb, var(--blue) 12%, var(--paper-3));
    border: 1.5px dashed color-mix(in srgb, var(--blue) 70%, transparent);
    mask: radial-gradient(circle 10px at 0 50%, transparent 98%, #000) left / 51% 100% no-repeat,
      radial-gradient(circle 10px at 100% 50%, transparent 98%, #000) right / 51% 100% no-repeat;
    box-shadow: var(--shadow);
  }
  .tt {
    font-family: var(--f-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 1rem;
    line-height: 1.35;
  }
  .stub .scribble {
    align-self: flex-end;
    font-size: 1.3rem;
  }

  @media (max-width: 1000px) {
    .board {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
    .bit {
      grid-column: span 3;
    }
    .note,
    .swatch {
      grid-column: span 2;
    }
  }
  @media (max-width: 560px) {
    .board {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.6rem 1rem;
    }
    .bit {
      grid-column: span 2;
    }
    .note,
    .swatch {
      grid-column: span 1;
    }
  }
</style>
