---
import { getCollection } from 'astro:content';
import { hash, inFileOrder, tilt } from '../lib/utils';
import raw from '../data/scrapbook.yaml?raw';

const items = inFileOrder(await getCollection('scrapbook'), raw);
const spans: Record<string, number> = { image: 3, quote: 4, link: 3, note: 2, swatch: 2, ticket: 4, mix: 5, sticker: 2, fortune: 3, guestbook: 4 };

/**
 * A YouTube link → the pieces needed for a click-to-play embed. Nothing loads
 * from YouTube (beyond the cover picture) until someone presses play.
 */
const youtube = (href = '') => {
  try {
    const u = new URL(href);
    const id = u.hostname.includes('youtu.be') ? u.pathname.slice(1) : u.searchParams.get('v') ?? '';
    const list = u.searchParams.get('list');
    const params = new URLSearchParams({ autoplay: '1', rel: '0' });
    if (list) params.set('list', list);
    return {
      thumb: `https://i.ytimg.com/vi/${id}/hqdefault.jpg`,
      embed: `https://www.youtube-nocookie.com/embed/${id}?${params}`,
    };
  } catch {
    return null;
  }
};
const host = (href = '') => {
  try {
    return new URL(href).hostname.replace(/^www\./, '');
  } catch {
    return href;
  }
};
---

<div class="board" id="scrapbook-board">
  {
    items.map(({ id, data }) => {
      const style = `--span:${spans[data.kind]};--rot:${tilt(id, 4)}deg;--dy:${Math.round(hash(id + 'y') * 40 - 10)}px;--dx:${Math.round(hash(id + 'x') * 20 - 10)}px`;
      return (
        <div class={`bit ${data.kind}`} style={style}>
          {data.kind === 'image' && (
            <figure class="photo">
              <span class="tape" aria-hidden="true" />
              <img src={data.src} alt={data.caption ?? ''} loading="lazy" width="600" height="750" />
              {data.caption && <figcaption>{data.caption}</figcaption>}
            </figure>
          )}
          {data.kind === 'quote' && (
            <blockquote>
              <p>“{data.text}”</p>
              {data.caption && <cite class="meta">— {data.caption}</cite>}
            </blockquote>
          )}
          {data.kind === 'link' && (
            <a href={data.href} class="bare label" data-cursor="visit ↗" rel="noopener">
              <span class="lt">{data.text} ↗</span>
              <span class="meta">{data.caption ?? host(data.href)}</span>
            </a>
          )}
          {data.kind === 'mix' &&
            (() => {
              const yt = youtube(data.href);
              return (
                <div class="mix">
                  <div class="mix-screen" data-yt={yt?.embed} data-yt-title={data.text}>
                    <button type="button" class="mix-play" data-cursor="play ▶" aria-label={`Play: ${data.text} (loads YouTube)`}>
                      {yt && <img src={yt.thumb} alt="" loading="lazy" width="480" height="360" onerror="this.remove()" />}
                      <span class="mix-btn" aria-hidden="true">
                        ▶
                      </span>
                    </button>
                  </div>
                  <div class="mix-label">
                    <span class="meta">side a · on repeat</span>
                    <span class="mix-t">{data.text}</span>
                    <a href={data.href} class="meta mix-open" rel="noopener">
                      {data.caption ?? 'open on youtube'} ↗
                    </a>
                  </div>
                </div>
              );
            })()}
          {data.kind === 'fortune' && (
            <div class="fortune" data-fortune={JSON.stringify(data.fortunes)}>
              <button type="button" class="star-btn" aria-expanded="false" data-cursor="make a wish">
                <span class="sr-only">Unfold the lucky star</span>
                <svg class="lstar" viewBox="0 0 200 200" aria-hidden="true">
                  <g class="lstar-body">
                    <polygon class="puff" points="100.0,26.0 123.5,71.6 174.2,79.9 138.0,116.4 145.8,167.1 100.0,144.0 54.2,167.1 62.0,116.4 25.8,79.9 76.5,71.6" />
                    <g class="shade"><polygon points="100,104 100.0,26.0 123.5,71.6" /><polygon points="100,104 174.2,79.9 138.0,116.4" /><polygon points="100,104 145.8,167.1 100.0,144.0" /><polygon points="100,104 54.2,167.1 62.0,116.4" /><polygon points="100,104 25.8,79.9 76.5,71.6" /></g>
                    <g class="facets"><line x1="100" y1="104" x2="123.5" y2="71.6" /><line x1="100" y1="104" x2="138.0" y2="116.4" /><line x1="100" y1="104" x2="100.0" y2="144.0" /><line x1="100" y1="104" x2="62.0" y2="116.4" /><line x1="100" y1="104" x2="76.5" y2="71.6" /><line class="ridge" x1="100" y1="104" x2="100.0" y2="26.0" /><line class="ridge" x1="100" y1="104" x2="174.2" y2="79.9" /><line class="ridge" x1="100" y1="104" x2="145.8" y2="167.1" /><line class="ridge" x1="100" y1="104" x2="54.2" y2="167.1" /><line class="ridge" x1="100" y1="104" x2="25.8" y2="79.9" /></g>
                    <ellipse class="shine" cx="78" cy="74" rx="10" ry="5" transform="rotate(-30 78 74)" />
                  </g>
                </svg>
              </button>
              <p class="slip" aria-live="polite">
                <span class="slip-text" />
              </p>
              <span class="scribble star-hint" aria-hidden="true">
                {data.caption ?? 'pick a lucky star'}
              </span>
              <span class="twinkle t1" aria-hidden="true">✦</span>
              <span class="twinkle t2" aria-hidden="true">✧</span>
              <span class="twinkle t3" aria-hidden="true">✦</span>
            </div>
          )}
          {data.kind === 'guestbook' && (
            <section class="gb" data-guestbook aria-labelledby={`gb-${id}`}>
              <svg class="gb-defs" aria-hidden="true" width="0" height="0">
                <defs>
                  <symbol id="st-0" viewBox="0 0 40 40">
                    <g><circle cx="20" cy="9" r="7" /><circle cx="30.5" cy="16.6" r="7" /><circle cx="26.5" cy="29" r="7" /><circle cx="13.5" cy="29" r="7" /><circle cx="9.5" cy="16.6" r="7" /></g>
                    <circle cx="20" cy="20" r="5" fill="#fff" fill-opacity=".55" />
                  </symbol>
                  <symbol id="st-1" viewBox="0 0 40 40"><path d="M20 3l5 11.3 12.3 1.2-9.3 8.2 2.7 12.1L20 29.6 9.3 35.8 12 23.7 2.7 15.5 15 14.3z" /></symbol>
                  <symbol id="st-2" viewBox="0 0 40 40"><path d="M20 35S4 25.5 4 14.5C4 8.7 8.4 5 13 5c3.2 0 5.6 1.8 7 4.2C21.4 6.8 23.8 5 27 5c4.6 0 9 3.7 9 9.5C36 25.5 20 35 20 35z" /></symbol>
                  <symbol id="st-3" viewBox="0 0 40 40"><path d="M27 4a16 16 0 1 0 9.5 22.5A13 13 0 0 1 27 4z" /></symbol>
                  <symbol id="st-4" viewBox="0 0 40 40"><path d="M20 2c1.6 9.6 8.4 16.4 18 18-9.6 1.6-16.4 8.4-18 18-1.6-9.6-8.4-16.4-18-18 9.6-1.6 16.4-8.4 18-18z" /></symbol>
                  <symbol id="st-5" viewBox="0 0 40 40">
                    <path fill-rule="evenodd" d="M20 3a17 17 0 1 1 0 34 17 17 0 0 1 0-34zm-6 12a2.4 2.4 0 1 0 0 4.8 2.4 2.4 0 0 0 0-4.8zm12 0a2.4 2.4 0 1 0 0 4.8 2.4 2.4 0 0 0 0-4.8zM12.6 23.5a1.4 1.4 0 0 0-1.1 2.2A10.2 10.2 0 0 0 20 30a10.2 10.2 0 0 0 8.5-4.3 1.4 1.4 0 1 0-2.3-1.6A7.4 7.4 0 0 1 20 27.2a7.4 7.4 0 0 1-6.2-3.1 1.4 1.4 0 0 0-1.2-.6z" />
                  </symbol>
                </defs>
              </svg>
              <header class="gb-head">
                <h3 id={`gb-${id}`}>{data.text ?? 'guestbook'}</h3>
                <span class="scribble gb-hint">{data.caption ?? 'leave a stamp, say hi'}</span>
              </header>
              <div class="gb-picker" role="group" aria-label="Choose a stamp">
                {['flower', 'star', 'heart', 'moon', 'sparkle', 'smiley'].map((name, i) => (
                  <button type="button" class="gb-pick" data-shape={i} aria-pressed={i === 0 ? 'true' : 'false'} aria-label={name}>
                    <svg aria-hidden="true"><use href={`#st-${i}`} /></svg>
                  </button>
                ))}
              </div>
              <div class="gb-page" data-cursor="stamp here" aria-hidden="true" />
              <footer class="gb-foot">
                <span class="meta gb-count" aria-live="polite">loading stamps…</span>
                <button type="button" class="gb-stamp meta">stamp it</button>
              </footer>
            </section>
          )}
          {data.kind === 'sticker' && (
            <figure class="sticker">
              <img src={data.src} alt={data.alt ?? ''} loading="lazy" />
              {data.caption && <figcaption class="scribble">{data.caption}</figcaption>}
            </figure>
          )}
          {data.kind === 'note' && (
            <p class="sticky">
              {data.caption && <span class="meta sticky-label">{data.caption}</span>}
              {data.text}
            </p>
          )}
          {data.kind === 'swatch' && (
            <div class="chip">
              <span class="c" style={`background:${data.color}`} />
              <span class="meta">{data.color}</span>
              <span class="ct">{data.text}</span>
            </div>
          )}
          {data.kind === 'ticket' && (
            <div class="stub">
              <span class="meta">no. {String(Math.floor(hash(id) * 90000) + 10000)}</span>
              <span class="tt">{data.text}</span>
              {data.caption && <span class="scribble">{data.caption}</span>}
            </div>
          )}
        </div>
      );
    })
  }
</div>

<style>
  .board {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-flow: dense;
    gap: 2.2rem var(--gutter);
    align-items: start;
    padding-block: 1rem 2rem;
  }
  .bit {
    grid-column: span var(--span);
    transform: translate(var(--dx), var(--dy)) rotate(var(--rot));
    transition: transform 0.5s var(--wobble);
    position: relative;
  }
  .bit:hover,
  .bit:focus-within {
    transform: translate(var(--dx), calc(var(--dy) - 6px)) rotate(0deg) scale(1.03);
    z-index: 5;
  }

  blockquote {
    margin: 0;
    background: var(--paper-3);
    padding: 1.4rem 1.4rem 2rem;
    box-shadow: var(--shadow);
    /* torn bottom edge */
    clip-path: polygon(0 0, 100% 0, 100% 92%, 94% 97%, 87% 93%, 79% 99%, 70% 94%, 61% 98%, 52% 93%, 43% 99%, 34% 94%, 25% 98%, 16% 93%, 8% 99%, 0 94%);
  }
  blockquote p {
    font-family: var(--f-display);
    font-style: italic;
    font-size: 1.75rem;
    line-height: 1.1;
    margin-bottom: 0.8rem;
  }
  cite {
    font-style: normal;
  }

  /* label-maker strip */
  .label {
    display: block;
    background: var(--ink);
    color: var(--paper);
    padding: 0.8rem 1rem;
    box-shadow: var(--shadow);
  }
  .label .lt {
    display: block;
    font-family: var(--f-mono);
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    line-height: 1.35;
    text-shadow: 0 1px 0 rgb(255 255 255 / 0.15);
  }
  .label .meta {
    color: var(--highlight);
    display: block;
    margin-top: 0.5rem;
    text-transform: none;
  }
  .label:hover .lt {
    text-decoration: underline wavy var(--accent) 1px;
    text-underline-offset: 0.3em;
  }

  /* mixtape: a little screen + a cassette-style label */
  .mix {
    background: var(--ink);
    padding: 10px 10px 0;
    box-shadow: var(--shadow);
  }
  .mix-screen {
    aspect-ratio: 16 / 9;
    background: #000;
    overflow: hidden;
  }
  .mix-screen :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  .mix-play {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: #111;
  }
  .mix-play img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.85;
    filter: saturate(0.85);
    transition: opacity 0.3s;
  }
  .mix-btn {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 3.4rem;
    height: 3.4rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    padding-left: 0.2rem;
    font-size: 1.2rem;
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--paper) 35%, transparent);
    transition: transform 0.35s var(--wobble);
  }
  .mix-play:hover img,
  .mix-play:focus-visible img {
    opacity: 1;
  }
  .mix-play:hover .mix-btn,
  .mix-play:focus-visible .mix-btn {
    transform: scale(1.12);
  }
  .mix-label {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin: 10px -10px 0;
    padding: 0.7rem 1rem 0.8rem;
    background-color: var(--paper-3);
    background-image: repeating-linear-gradient(
      transparent 0 1.55rem,
      color-mix(in srgb, var(--blue) 20%, transparent) 1.55rem calc(1.55rem + 1px)
    );
    border-top: 4px solid var(--accent);
  }
  .mix-label .meta {
    color: var(--ink-soft);
  }
  .mix-t {
    font-family: var(--f-hand);
    font-size: 1.5rem;
    line-height: 1.1;
    color: var(--blue);
  }
  .mix-open {
    align-self: flex-end;
    text-transform: none;
    letter-spacing: 0.02em;
  }

  /* lucky star: a puffy paper star that spins open, and its paper strip unrolls with a message */
  .fortune {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 0.5rem;
  }
  .star-btn {
    all: unset;
    cursor: pointer;
    width: min(100%, 13rem);
    position: relative;
    z-index: 2;
  }
  .star-btn:focus-visible {
    outline: 2px dashed var(--accent);
    outline-offset: 6px;
  }
  .lstar {
    width: 72%;
    height: auto;
    margin: 0 auto;
    display: block;
    overflow: visible;
    filter: drop-shadow(2px 4px 3px rgb(0 0 0 / 0.16));
  }
  .lstar-body {
    transform-box: view-box;
    transform-origin: 100px 104px;
    transition: transform 0.7s var(--wobble);
  }
  .lstar .puff {
    fill: #f6d86b;
    stroke: #f6d86b;
    stroke-width: 18;
    stroke-linejoin: round;
  }
  .lstar .shade polygon {
    fill: #e9bf45;
    opacity: 0.7;
  }
  .lstar .facets line {
    stroke: #d6a932;
    stroke-width: 1.4;
    stroke-linecap: round;
    opacity: 0.7;
  }
  .lstar .facets .ridge {
    stroke: #fff4c4;
    opacity: 0.6;
  }
  .lstar .shine {
    fill: #fffbe8;
    opacity: 0.75;
  }
  .star-btn:hover .lstar-body {
    transform: rotate(-10deg) scale(1.05);
  }
  .fortune.open .lstar-body {
    transform: rotate(144deg) scale(0.82);
  }
  .twinkle {
    position: absolute;
    color: var(--yellow);
    font-size: 1rem;
    pointer-events: none;
    animation: twinkle 2.4s ease-in-out infinite;
  }
  .t1 {
    top: 0.2rem;
    right: 12%;
  }
  .t2 {
    top: 42%;
    left: 6%;
    font-size: 0.8rem;
    animation-delay: 0.8s;
  }
  .t3 {
    top: 30%;
    right: 4%;
    font-size: 0.7rem;
    animation-delay: 1.5s;
  }
  @keyframes twinkle {
    0%,
    100% {
      opacity: 0.2;
      transform: scale(0.7);
    }
    50% {
      opacity: 1;
      transform: scale(1.1);
    }
  }
  .slip {
    position: relative;
    z-index: 1;
    margin: 0.2rem 0 0;
    width: min(112%, 16rem);
    padding: 0.7rem 0.9rem 0.55rem;
    background: #fbfaf4;
    color: #1a2117;
    border: 1px solid rgb(0 0 0 / 0.08);
    box-shadow: 0 2px 4px rgb(0 0 0 / 0.12);
    text-align: center;
    transform-origin: top center;
    transform: translateY(-3rem) scaleY(0.05);
    opacity: 0;
    transition:
      transform 0.55s var(--wobble) 0.15s,
      opacity 0.2s 0.15s;
  }
  .fortune.open .slip {
    transform: rotate(-2deg) translateY(-0.6rem);
    opacity: 1;
  }
  .slip-text {
    display: block;
    font-family: var(--f-body);
    font-size: 0.98rem;
    line-height: 1.35;
  }
  .star-hint {
    position: absolute;
    top: calc(min(100%, 13rem) * 0.8);
    margin: 0;
    font-size: 1.2rem;
    transition: opacity 0.3s;
  }
  .fortune.open .star-hint {
    opacity: 0;
  }

  /* guestbook: a card visitors can stamp; stamps are shared through /api/stamps */
  .gb {
    background: var(--paper-3);
    border: 1px solid var(--rule);
    box-shadow: var(--shadow);
    padding: 0.9rem 1rem 0.7rem;
  }
  .gb-defs {
    position: absolute;
  }
  .gb-head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.2rem 0.7rem;
  }
  .gb-head h3 {
    font-size: 1.7rem;
    font-style: italic;
  }
  .gb-hint {
    font-size: 1.2rem;
  }
  .gb-picker {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0.6rem 0 0.5rem;
  }
  .gb-pick {
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink-soft);
    transition:
      transform 0.25s var(--wobble),
      background-color 0.2s;
  }
  .gb-pick svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: currentColor;
  }
  .gb-pick:hover {
    transform: rotate(-10deg) scale(1.08);
  }
  .gb-pick[aria-pressed='true'] {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
  .gb-page {
    position: relative;
    aspect-ratio: 16 / 9;
    border: 1px dashed var(--rule);
    background-image: radial-gradient(color-mix(in srgb, var(--ink) 12%, transparent) 1px, transparent 1.2px);
    background-size: 14px 14px;
    overflow: hidden;
    cursor: crosshair;
  }
  .gb-page :global(.ink) {
    position: absolute;
    width: 1.9rem;
    height: 1.9rem;
    margin: -0.95rem 0 0 -0.95rem;
    opacity: 0.82;
    mix-blend-mode: multiply;
    pointer-events: none;
  }
  :global(:root[data-theme='dark']) .gb-page :global(.ink) {
    mix-blend-mode: normal;
  }
  .gb-page :global(.ink.new) {
    animation: thunk 0.45s var(--wobble);
  }
  @keyframes thunk {
    from {
      transform: scale(1.8) rotate(var(--r));
      opacity: 0;
    }
  }
  .gb-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }
  .gb-count {
    text-transform: none;
    letter-spacing: 0.02em;
  }
  .gb-stamp {
    flex: none;
    white-space: nowrap;
    border: 1px solid var(--ink);
    background: none;
    color: var(--ink);
    padding: 0.2rem 0.6rem;
  }
  .gb-stamp:hover {
    background: var(--highlight);
  }
  .gb-stamp:disabled {
    opacity: 0.5;
  }

  /* die-cut vinyl sticker: a white outline hugging the shape + a soft shadow */
  .sticker {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .sticker img {
    width: min(100%, 11rem);
    height: auto;
    filter: drop-shadow(3px 0 0 #fff) drop-shadow(-3px 0 0 #fff) drop-shadow(0 3px 0 #fff) drop-shadow(0 -3px 0 #fff)
      drop-shadow(2px 4px 3px rgb(0 0 0 / 0.18));
    transition: transform 0.45s var(--wobble);
  }
  .bit:hover .sticker img {
    transform: rotate(-6deg) scale(1.04);
  }
  .sticker figcaption {
    margin-top: 0.4rem;
    font-size: 1.2rem;
  }

  .sticky {
    margin: 0;
    background: var(--sticky);
    color: var(--ink);
    aspect-ratio: 1;
    padding: 1rem;
    font-family: var(--f-hand);
    font-size: 1.5rem;
    line-height: 1.1;
    box-shadow:
      var(--shadow),
      inset 0 -18px 18px -18px rgb(0 0 0 / 0.2);
  }

  .sticky-label {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.5rem;
    color: var(--accent);
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.12em;
  }
  /* a little empty checkbox — still to do */
  .sticky-label::before {
    content: '';
    width: 0.8rem;
    height: 0.8rem;
    border: 1.5px solid currentColor;
    border-radius: 2px;
  }

  .chip {
    display: flex;
    flex-direction: column;
    background: var(--paper-3);
    padding: 8px 8px 12px;
    border: 1px solid var(--rule);
    box-shadow: var(--shadow);
  }
  .chip .c {
    aspect-ratio: 1;
    margin-bottom: 0.6rem;
  }
  .ct {
    font-size: 0.9rem;
    line-height: 1.3;
    margin-top: 0.2rem;
  }

  /* ticket stub with punched edges */
  .stub {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.1rem 1.6rem;
    background: color-mix(in srgb, var(--blue) 12%, var(--paper-3));
    border: 1.5px dashed color-mix(in srgb, var(--blue) 70%, transparent);
    mask: radial-gradient(circle 10px at 0 50%, transparent 98%, #000) left / 51% 100% no-repeat,
