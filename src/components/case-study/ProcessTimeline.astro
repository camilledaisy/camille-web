---
/**
 * The research-process track. Each stage is done / current / next / planned,
 * and every state is spelled out in text (not just color).
 */
interface Stage {
  name: string;
  state: 'done' | 'current' | 'next' | 'planned';
}
interface Props {
  stages: readonly Stage[];
}
const { stages } = Astro.props;
const labels = { done: 'done', current: 'in progress', next: 'next', planned: 'planned' };
const marks = { done: '✓', current: '●', next: '→', planned: '' };
---

<ol class="track" style={`--n:${stages.length}`}>
  {
    stages.map((s, i) => (
      <li class="stage" data-state={s.state} aria-current={s.state === 'current' ? 'step' : undefined}>
        {s.state === 'current' && (
          <span class="here scribble" aria-hidden="true">
            you are here ↓
          </span>
        )}
        <span class="dot" aria-hidden="true">
          {marks[s.state]}
        </span>
        <span class="num meta">{String(i + 1).padStart(2, '0')}</span>
        <span class="name">{s.name}</span>
        <span class="state meta">{labels[s.state]}</span>
      </li>
    ))
  }
</ol>

<style>
  .track {
    list-style: none;
    margin: 0;
    padding: 2.4rem 0 0;
    display: grid;
    grid-template-columns: repeat(var(--n, 8), minmax(0, 1fr));
    grid-auto-flow: column;
    position: relative;
  }
  .stage {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-right: 0.8rem;
  }
  /* the line joining the dots */
  .stage::before {
    content: '';
    position: absolute;
    top: 0.75rem;
    left: 1.6rem;
    right: 0;
    border-top: 1.5px dashed var(--ink-faint);
  }
  .stage:last-child::before {
    display: none;
  }
  .stage[data-state='done']::before {
    border-top-style: solid;
    border-top-color: var(--accent);
  }
  .dot {
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 0.75rem;
    line-height: 1;
    border: 1.5px dashed var(--ink-faint);
    background: var(--paper);
    color: var(--paper);
    position: relative;
    z-index: 1;
  }
  .stage[data-state='done'] .dot {
    background: var(--accent);
    border: 1.5px solid var(--accent);
  }
  .stage[data-state='current'] .dot {
    background: var(--blue);
    border: 1.5px solid var(--blue);
    font-size: 0.55rem;
  }
  .stage[data-state='current'] .dot::after {
    content: '';
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 1.5px solid var(--blue);
    animation: ping 2.2s var(--ease) infinite;
  }
  .stage[data-state='next'] .dot {
    border: 1.5px solid var(--accent);
    color: var(--accent);
  }
  .name {
    font-family: var(--f-display);
    font-size: 1.15rem;
    overflow-wrap: anywhere;
    line-height: 1.05;
    margin-top: 0.35rem;
  }
  .stage[data-state='planned'] .name {
    color: var(--ink-soft);
  }
  .state {
    font-size: 0.64rem;
  }
  .stage[data-state='current'] .state {
    color: var(--blue);
    font-weight: 500;
  }
  .stage[data-state='next'] .state {
    color: var(--accent);
  }
  .here {
    position: absolute;
    top: -2.2rem;
    left: -0.2rem;
    font-size: 1.25rem;
    white-space: nowrap;
  }
  @keyframes ping {
    0% {
      transform: scale(0.8);
      opacity: 1;
    }
    100% {
      transform: scale(1.5);
      opacity: 0;
    }
  }

  /* vertical on smaller screens */
  @media (max-width: 1200px) {
    .track {
      grid-template-columns: 1fr;
      grid-auto-flow: row;
      padding-top: 0.5rem;
      gap: 0;
    }
    .stage {
      display: grid;
      grid-template-columns: 1.5rem 2rem 1fr auto;
      align-items: baseline;
      column-gap: 0.8rem;
      padding: 0 0 1.3rem;
    }
    .stage::before {
      top: 1.6rem;
      bottom: 0;
      left: 0.75rem;
      right: auto;
      border-top: 0;
      border-left: 1.5px dashed var(--ink-faint);
    }
    .stage[data-state='done']::before {
      border-left: 1.5px solid var(--accent);
    }
    .dot {
      align-self: start;
    }
    .name {
      margin-top: 0;
    }
    .here {
      position: static;
      grid-column: 3;
      grid-row: 2;
      font-size: 1.15rem;
    }
  }
</style>
