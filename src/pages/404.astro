---
import Base from '../layouts/Base.astro';
---

<Base title="Lost" noindex>
  <div class="wrap lost">
    <pre aria-hidden="true">{String.raw`
     .--.
    |o_o |      4 0 4
    |:_/ |
   //   \ \     this page wandered off
  (|     | )    into the garden.
 /'\_   _/'\
 \___)=(___/
`}</pre>
    <h1>Page not found</h1>
    <p>It might have been moved, renamed, or composted. Try the <a href="/">front door</a> instead.</p>
  </div>
</Base>

<style>
  .lost {
    padding-block: 6rem;
    text-align: center;
  }
  pre {
    display: inline-block;
    text-align: left;
    font-family: var(--f-mono);
    color: var(--red);
    font-size: 0.95rem;
  }
  h1 {
    font-size: clamp(3rem, 2rem + 4vw, 6rem);
    font-style: italic;
    margin: 1.5rem 0 1rem;
  }
</style>
