---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import { elsewhere, site } from '../site.config';

/* This page is plain HTML — edit the words directly below. */
---

<Base title="About" description="Who Daisy is, what this website is, and how to say hi.">
  <div class="wrap">
    <header class="page-head grid">
      <div class="ph">
        <p class="meta">§ about · the person behind the curtain</p>
        <h1>Hello<span class="red">.</span></h1>
      </div>
    </header>

    <div class="grid main">
      <div class="prose dropcap text">
        <p>
          I’m Daisy. I’m figuring out what I want to make and how I want to make it. Lately, that means learning about UX
          research, designing things that live on screens, and turning ideas I have in my head into things people can
          actually click on.
        </p>
        <p>
          When I’m not doing that, I’m probably reading a book, writing something I may or may not ever finish, watching
          a film, or falling into a very specific internet rabbit hole. I like stories that make me think, psychology,
          strange little websites, philosophy, and learning far too much about whatever has my attention that week.
        </p>
        <p>
          This website is my little corner of the internet. Part notebook, part scrapbook, part archive of things I’ve
          made and things I like. It isn’t meant to be perfectly polished or finished. I want it to change as I do.
        </p>
        <p>Things will appear, disappear, break, get rewritten, and probably move around for no particular reason.</p>
        <p>That’s kind of the point.</p>
      </div>

      <figure class="photo portrait">
        <span class="tape" aria-hidden="true"></span>
        <img
          src="/img/about/daisy-childhood.jpg"
          alt="Daisy as a small child in a light blue bucket hat and sleeveless top, leaning against a yellow pillar in a leafy garden, lips pursed."
          width="1400"
          height="905"
        />
        <figcaption>me, approximately</figcaption>
      </figure>
    </div>

    <section class="section grid story-sec" id="story" aria-labelledby="story-h">
      <div class="story">
        <SectionHead num="01" id="story-h" title="The story of Daisy" note="a true story, somehow" />
        <div class="prose">
          <p>
            My name is actually Camille, but <strong>Daisy</strong> has been my nickname since childhood—and there’s a bit of
            a story behind it.
          </p>
          <p>
            When I was a baby in the Philippines, I was sick a lot, and even the doctors couldn’t quite figure out what was
            wrong. Eventually, my parents brought me to a Filipino woman who practiced traditional folk rituals. She cracked
            an egg into a glass of water and began saying different names aloud. When she said <strong
              class="name-said">“Daisy Siete,”</strong
            > the yolk rose to the top of the glass.
          </p>
          <p>My family started calling me Daisy after that—and, strangely enough, I stopped getting sick.</p>
          <p>
            Do I know how that worked? Absolutely not. But the name stuck, and so did the story. <strong
              >Daisy became more than a childhood nickname; it became a little piece of my family, my culture, and the story
              of how I became me.</strong
            >
          </p>
        </div>
      </div>
      <pre class="glass" aria-hidden="true">{String.raw`
   .---------.
   |    o    |   <- the yolk,
   |  ~~~~~  |      rising
   |         |
   |         |
    \_______/
`}</pre>
    </section>

    <section class="section grid" aria-labelledby="hi-h">
      <div class="hi" id="say-hi">
        <SectionHead num="02" id="hi-h" title="Say hi" />
        <p>
          I love getting emails from strangers — about a post, a book, a project, or nothing at all. The best way to reach
          me is <a href={`mailto:${site.email}`}>{site.email}</a>.
        </p>
        <ul class="links">
          {elsewhere.map((l) => (
            <li>
              <a class="swap bare" href={l.href}>
                <span>{l.label}</span>
                <span aria-hidden="true">{l.label} ↗</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section grid" id="colophon" aria-labelledby="colo-h">
      <div class="colo">
        <SectionHead num="03" id="colo-h" title="Colophon" note="how this place is built" />
        <dl>
          <div><dt>built with</dt><dd>Astro, plain CSS, a little JavaScript, and too much fiddling</dd></div>
          <div><dt>type</dt><dd>Instrument Serif, Newsreader, IBM Plex Mono & Caveat — all from Google Fonts</dd></div>
          <div><dt>images</dt><dd>my own, or risograph-ish placeholders until I scan the real ones</dd></div>
          <div><dt>tracking</dt><dd>none. no cookies, no analytics. the visit counter lives only in your browser.</dd></div>
          <div><dt>inspired by</dt><dd>personal Tumblr themes, GeoCities, literary magazines, zines & every digital garden I’ve wandered into</dd></div>
          <div><dt>secrets</dt><dd>a few. look closely.</dd></div>
        </dl>
      </div>
    </section>
  </div>
</Base>

<style>
  .ph {
    grid-column: 1 / span 10;
  }
  .red {
    color: var(--accent);
  }
  .main {
    align-items: start;
  }
  .text {
    grid-column: 2 / span 6;
  }
  .portrait {
    grid-column: 8 / span 5;
    margin-top: -4rem;
    transform: rotate(3deg);
    transition: transform 0.5s var(--wobble);
  }
  .portrait:hover {
    transform: rotate(-2deg) scale(1.02);
  }
  /* no white polaroid frame here — just the photo, taped down */
  .portrait {
    background: none;
    border: 0;
    padding: 0;
    box-shadow: none;
  }
  .portrait img {
    aspect-ratio: auto;
    box-shadow: var(--shadow);
  }
  .portrait figcaption {
    position: static;
    margin-top: 0.6rem;
  }
  .story {
    grid-column: 2 / span 7;
  }
  .story strong {
    font-weight: 600;
  }
  .name-said {
    font-family: var(--f-display);
    font-style: italic;
    font-weight: 400 !important;
    font-size: 1.25em;
    color: var(--accent);
    white-space: nowrap;
  }
  .glass {
    grid-column: 10 / span 3;
    align-self: center;
    margin: 4rem 0 0;
    font-family: var(--f-mono);
    font-size: 0.85rem;
    line-height: 1.25;
    color: var(--blue);
    transform: rotate(-3deg);
  }
  .hi {
    grid-column: 3 / span 8;
  }
  .links {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    font-family: var(--f-mono);
    font-size: 0.9rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
  }
  .colo {
    grid-column: 3 / span 8;
  }
  .colo dl {
    margin: 0;
  }
  .colo dl > div {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 1rem;
    padding: 0.6rem 0;
    border-bottom: 1px dotted var(--rule);
  }
  .colo dt {
    font-family: var(--f-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-soft);
    padding-top: 0.3rem;
  }
  .colo dd {
    margin: 0;
  }
  @media (max-width: 860px) {
    .portrait {
      margin-top: 2rem;
      max-width: 26rem;
    }
    .glass {
      display: none;
    }
    .hi {
      margin-top: 0;
    }
    .colo dl > div {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
