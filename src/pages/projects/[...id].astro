---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getProjects, longDate, tilt } from '../../lib/utils';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { id: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props;
const { Content } = await render(project);
const { title, date, type, summary, image, status, role, tools, link } = project.data;
---

<Base title={title} description={summary}>
  <article class="wrap">
    <header class="grid head">
      <div class="h">
        <p class="meta kicker">
          <a class="draw" href={`/projects?f=${type}`}>#{type}</a>
          <span aria-hidden="true">·</span>
          <time datetime={date.toISOString()}>{longDate(date)}</time>
        </p>
        <h1>{title}</h1>
        <p class="deck">{summary}</p>
      </div>
      {
        image && (
          <figure class="photo hero" style={`--rot:${tilt(project.id, 3)}deg`}>
            <span class="tape" aria-hidden="true" />
            <img src={image} alt="" width="600" height="750" />
            <figcaption>{title.toLowerCase()}, fig. 1</figcaption>
          </figure>
        )
      }
    </header>

    <div class="grid body">
      <aside class="spec" aria-label="Project details">
        <pre class="meta" aria-hidden="true">+-- spec sheet --------+</pre>
        <dl>
          <div><dt>status</dt><dd><span class="stamp" data-status={status}>{status}</span></dd></div>
          <div><dt>year</dt><dd>{date.getUTCFullYear()}</dd></div>
          {role && <div><dt>role</dt><dd>{role}</dd></div>}
          {tools.length > 0 && <div><dt>tools</dt><dd>{tools.join(', ')}</dd></div>}
          {link && <div><dt>link</dt><dd><a href={link}>visit ↗</a></dd></div>}
        </dl>
        <pre class="meta" aria-hidden="true">+---------------------+</pre>
      </aside>
      <div class="prose text">
        <Content />
      </div>
    </div>

    <nav class="next" aria-label="Next project">
      <a class="bare" href={`/projects/${next.id}`} data-preview={next.data.image} data-cursor="next one →">
        <span class="meta">next project →</span>
        <span class="nt">{next.data.title}</span>
      </a>
      <a class="draw meta" href="/projects">← all projects</a>
    </nav>
  </article>
</Base>

<style>
  .head {
    padding-block: clamp(2.5rem, 6vw, 5rem) 3rem;
    align-items: end;
  }
  .h {
    grid-column: 1 / span 7;
  }
  .kicker {
    display: flex;
    gap: 0.6rem;
    color: var(--accent);
    margin-bottom: 1.2rem;
  }
  h1 {
    font-size: clamp(3rem, 2rem + 5vw, 7.5rem);
    font-style: italic;
    line-height: 0.88;
    letter-spacing: -0.025em;
  }
  .deck {
    font-size: clamp(1.2rem, 1rem + 0.7vw, 1.6rem);
    line-height: 1.35;
    color: var(--ink-soft);
    max-width: 36ch;
    margin-top: 1.4rem;
  }
  .hero {
    grid-column: 9 / span 4;
    transform: rotate(var(--rot));
    transition: transform 0.5s var(--wobble);
  }
  .hero:hover {
    transform: rotate(0);
  }
  .body {
    border-top: 1px solid var(--ink);
    padding-top: 2.5rem;
  }
  .spec {
    grid-column: 1 / span 3;
    align-self: start;
    position: sticky;
    top: 1.5rem;
  }
  .spec pre {
    margin: 0;
    color: var(--ink-faint);
    text-transform: none;
    overflow: hidden;
  }
  .spec dl {
    margin: 0.6rem 0;
  }
  .spec dl > div {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 0.8rem;
    padding: 0.35rem 0;
    border-bottom: 1px dotted var(--rule);
    font-size: 0.95rem;
  }
  .spec dt {
    font-family: var(--f-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-soft);
    padding-top: 0.2rem;
  }
  .spec dd {
    margin: 0;
  }
  .text {
    grid-column: 5 / span 7;
    max-width: 38em;
  }
  .next {
    margin-top: 5rem;
    border-top: 1px solid var(--ink);
    padding-top: 1.2rem;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .next > a:first-child {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .nt {
    font-family: var(--f-display);
    font-size: clamp(2.2rem, 1.6rem + 2.5vw, 4rem);
    line-height: 1;
    transition:
      color 0.2s,
      transform 0.4s var(--wobble);
  }
  .next a:hover .nt {
    color: var(--accent);
    font-style: italic;
    transform: translateX(0.5rem);
  }
  @media (max-width: 860px) {
    .hero {
      max-width: 22rem;
      margin-top: 2rem;
    }
    .spec {
      position: static;
      margin-bottom: 2rem;
    }
  }
</style>
