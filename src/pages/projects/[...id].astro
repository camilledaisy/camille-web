---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SpecSheet from '../../components/SpecSheet.astro';
import ProjectNext from '../../components/ProjectNext.astro';
import { getProjects, longDate, tilt } from '../../lib/utils';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects
    .map((project, i) => ({
      params: { id: project.id },
      props: { project, next: projects[(i + 1) % projects.length] },
    }))
    // projects with `customPage: true` have their own hand-built page in this folder
    .filter(({ props }) => !props.project.data.customPage);
}

const { project, next } = Astro.props;
const { Content } = await render(project);
const { title, date, type, summary, image, status, role, tools, link } = project.data;
const specRows = [
  { label: 'status', value: status, stamp: true },
  { label: 'year', value: String(date.getUTCFullYear()) },
  ...(role ? [{ label: 'role', value: role }] : []),
  ...(tools.length ? [{ label: 'tools', value: tools.join(', ') }] : []),
  ...(link ? [{ label: 'link', value: 'visit ↗', href: link }] : []),
];
---

<Base title={title} description={summary}>
  <article class="wrap">
    <header class="grid head">
      <div class="h">
        <p class="meta kicker">
          <a class="draw" href={`/projects?f=${type}`}>#{type}</a>
          <span aria-hidden="true">·</span>
          <time datetime={date.toISOString()}>{longDate(date)}</time>
        </p>
        <h1>{title}</h1>
        <p class="deck">{summary}</p>
      </div>
      {
        image && (
          <figure class="photo hero" style={`--rot:${tilt(project.id, 3)}deg`}>
            <span class="tape" aria-hidden="true" />
            <img src={image} alt="" width="600" height="750" />
            <figcaption>{title.toLowerCase()}, fig. 1</figcaption>
          </figure>
        )
      }
    </header>

    <div class="grid body">
      <aside class="spec" aria-label="Project details">
        <SpecSheet rows={specRows} />
      </aside>
      <div class="prose text">
        <Content />
      </div>
    </div>

    <ProjectNext next={next} />
  </article>
</Base>

<style>
  .head {
    padding-block: clamp(2.5rem, 6vw, 5rem) 3rem;
    align-items: end;
  }
  .h {
    grid-column: 1 / span 7;
  }
  .kicker {
    display: flex;
    gap: 0.6rem;
    color: var(--accent);
    margin-bottom: 1.2rem;
  }
  h1 {
    font-size: clamp(3rem, 2rem + 5vw, 7.5rem);
    font-style: italic;
    line-height: 0.88;
    letter-spacing: -0.025em;
  }
  .deck {
    font-size: clamp(1.2rem, 1rem + 0.7vw, 1.6rem);
    line-height: 1.35;
    color: var(--ink-soft);
    max-width: 36ch;
    margin-top: 1.4rem;
  }
  .hero {
    grid-column: 9 / span 4;
    transform: rotate(var(--rot));
    transition: transform 0.5s var(--wobble);
  }
  .hero:hover {
    transform: rotate(0);
  }
  .body {
    border-top: 1px solid var(--ink);
    padding-top: 2.5rem;
  }
  .spec {
    grid-column: 1 / span 3;
    align-self: start;
    position: sticky;
    top: 1.5rem;
  }
  .text {
    grid-column: 5 / span 7;
    max-width: 38em;
  }
  @media (max-width: 860px) {
    .hero {
      max-width: 22rem;
      margin-top: 2rem;
    }
    .spec {
      position: static;
      margin-bottom: 2rem;
    }
  }
</style>
