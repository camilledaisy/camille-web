---
/**
 * Communimate — case study page.
 *
 * You shouldn't need to edit this file to update the project:
 * all the words, lists, and statuses live in src/data/communimate.ts.
 */
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SpecSheet from '../../components/SpecSheet.astro';
import ProjectNext from '../../components/ProjectNext.astro';
import CaseSection from '../../components/case-study/CaseSection.astro';
import Chip from '../../components/case-study/Chip.astro';
import Placeholder from '../../components/case-study/Placeholder.astro';
import ProcessTimeline from '../../components/case-study/ProcessTimeline.astro';
import SourceCard from '../../components/case-study/SourceCard.astro';
import CompetitorCard from '../../components/case-study/CompetitorCard.astro';
import Checklist from '../../components/case-study/Checklist.astro';
import { getProjects, stamp, tilt } from '../../lib/utils';
import { site } from '../../site.config';
import * as cs from '../../data/communimate';

const entry = (await getEntry('projects', 'communimate'))!;
const projects = await getProjects();
const next = projects[(projects.findIndex((p) => p.id === entry.id) + 1) % projects.length];

const updated = new Date(cs.status.lastUpdated);
const stageNow = cs.process.findIndex((s) => s.state === 'current');
const stageBar = cs.process.map((s) => (s.state === 'done' ? '■' : s.state === 'current' ? '▣' : '□')).join('');

// the table of contents + section ids, in page order
const sections = [
  { id: 'overview', num: '01', title: 'Overview' },
  { id: 'problem', num: '02', title: 'The problem space' },
  { id: 'question', num: '03', title: 'Initial question' },
  { id: 'known', num: '04', title: 'What I know so far' },
  { id: 'goals', num: '05', title: 'Research goals' },
  { id: 'people', num: '06', title: 'Who I’m designing for' },
  { id: 'process', num: '07', title: 'Research process' },
  { id: 'questions', num: '08', title: 'Current research questions' },
  { id: 'competitive', num: '09', title: 'Competitive research' },
  { id: 'library', num: '10', title: 'Research library' },
  { id: 'design', num: '11', title: 'Design exploration' },
  { id: 'learning', num: '12', title: 'What I’m learning' },
  { id: 'next', num: '13', title: 'What’s next' },
];
const s = Object.fromEntries(sections.map((x) => [x.id, x]));
---

<Base title={cs.hero.title} description={cs.hero.description}>
  <article class="wrap cs">
    <!-- ───────────── hero ───────────── -->
    <header class="grid hero">
      <div class="intro">
        <p class="meta kicker">
          <a class="draw" href="/projects">← projects</a>
          <span aria-hidden="true">/</span>
          <span>project file · case study</span>
          <span aria-hidden="true">/</span>
          <a class="draw" href={`/projects?f=${entry.data.type}`}>#{entry.data.type}</a>
        </p>
        <h1>{cs.hero.title}</h1>
        <p class="tags meta">
          {
            cs.hero.tags.map((t, i) => (
              <>
                {i > 0 && <span aria-hidden="true"> · </span>}
                <span>{t}</span>
              </>
            ))
          }
        </p>
        <p class="context">{cs.hero.context}</p>
        <p class="deck">{cs.hero.description}</p>
      </div>

      <aside class="status" aria-labelledby="status-h">
        <span class="tape" aria-hidden="true"></span>
        <h2 id="status-h" class="meta">project status</h2>
        <p class="badge">
          <span class="pulse" aria-hidden="true"></span>
          <span><strong>Status:</strong> {cs.status.label} / {cs.status.detail}</span>
        </p>
        <dl>
          <div>
            <dt>phase</dt>
            <dd>{cs.status.phase}</dd>
          </div>
          <div>
            <dt>stage</dt>
            <dd>
              <span class="bar" aria-hidden="true">{stageBar}</span>
              <span>
                {stageNow + 1} of {cs.process.length}
              </span>
            </dd>
          </div>
          <div>
            <dt>updated</dt>
            <dd>
              Last updated: <time datetime={cs.status.lastUpdated}>{stamp(updated)}</time>
            </dd>
          </div>
        </dl>
        <p class="scribble early" aria-hidden="true">(it’s early days!)</p>
      </aside>

      <div class="hero-media">
        {
          cs.hero.image.src ? (
            <figure class="photo" style={`--rot:${tilt('communimate', 1.2)}deg`}>
              <span class="tape" aria-hidden="true" />
              <img src={cs.hero.image.src} alt={cs.hero.image.alt} />
              {cs.hero.image.caption && <figcaption>{cs.hero.image.caption}</figcaption>}
            </figure>
          ) : (
            <Placeholder
              label="hero image / mockup"
              hint="nothing to show yet — on purpose"
              ratio="16 / 5"
              size="lg"
            />
          )
        }
      </div>

      <p class="guide meta">
        <span aria-hidden="true">※</span> how to read this page: anything marked
        <Chip tone="hypothesis">hypothesis</Chip>, <Chip tone="progress">in progress</Chip> or
        <Chip tone="planned">planned</Chip> is exactly that. there are no findings here yet.
      </p>
    </header>

    <!-- ───────────── body ───────────── -->
    <div class="grid body">
      <nav class="toc" aria-label="On this page">
        <p class="meta toc-h">contents</p>
        <ol>
          {
            sections.map((x) => (
              <li>
                <a class="draw" href={`#${x.id}`}>
                  <span class="meta">{x.num}</span> {x.title}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      <div class="sections">
        <!-- 01 overview -->
        <CaseSection {...s.overview}>
          <div class="two">
            <div class="prose">
              {cs.overview.map((p) => <p>{p}</p>)}
            </div>
            <SpecSheet title="project info" rows={cs.projectInfo} />
          </div>
        </CaseSection>

        <!-- 02 problem space -->
        <CaseSection {...s.problem} chip="a question I’m investigating" tone="hypothesis">
          <div class="prose narrow">
            {cs.problemSpace.paragraphs.map((p) => <p>{p}</p>)}
          </div>
          <figure class="tension" aria-labelledby="tension-cap">
            <div class="side">
              <p class="meta">AAC tools need to prioritize</p>
              <ul>{cs.problemSpace.mustPrioritize.map((x) => <li>{x}</li>)}</ul>
            </div>
            <div class="vs" aria-hidden="true">
              <span>←?→</span>
            </div>
            <div class="side">
              <p class="meta">the experience may also depend on</p>
              <ul>{cs.problemSpace.mayAlsoMatter.map((x) => <li>{x}</li>)}</ul>
            </div>
            <figcaption id="tension-cap" class="meta">
              fig. 1 — a potential tension, sketched as a question. not a finding.
            </figcaption>
          </figure>
        </CaseSection>

        <!-- 03 initial question -->
        <CaseSection {...s.question} chip="working question — will evolve" tone="progress">
          <div class="big-q">
            <span class="qmark" aria-hidden="true">?</span>
            <p class="q">{cs.initialQuestion}</p>
            <p class="scribble q-note" aria-hidden="true">← the question guiding everything (for now)</p>
          </div>
        </CaseSection>

        <!-- 04 what I know so far -->
        <CaseSection {...s.known} chip="secondary research — notes, not findings" tone="source">
          <p class="lead">
            Notes from what I’ve read so far. They’re paraphrased from the sources below and kept close to what each
            source actually says — they’re background, not conclusions of my own.
          </p>
          <div class="sources">
            {cs.sources.map((src, i) => <SourceCard source={src} index={i} />)}
            <Placeholder label={`source ${String(cs.sources.length + 1).padStart(2, '0')}`} hint="next source goes here" ratio="auto" />
          </div>
        </CaseSection>

        <!-- 05 research goals -->
        <CaseSection {...s.goals} chip="goals — not results" tone="progress">
          <ol class="goals">
            {
              cs.goals.map((g, i) => (
                <li>
                  <span class="meta gn">G-{String(i + 1).padStart(2, '0')}</span>
                  <span>{g}</span>
                </li>
              ))
            }
          </ol>
        </CaseSection>

        <!-- 06 who I'm designing for -->
        <CaseSection {...s.people} chip="still learning about these groups" tone="progress">
          <p class="caveat">
            <strong>I’m currently researching these groups.</strong> This is who I want to learn from — not a summary
            of what they need. I haven’t created personas: those should come from real research, not assumptions.
          </p>
          <div class="people">
            <div class="who primary">
              <p class="meta">primary users</p>
              <p class="who-main">{cs.audiences.primary}</p>
            </div>
            <div class="who">
              <p class="meta">secondary stakeholders</p>
              <ul>{cs.audiences.secondary.map((x) => <li>{x}</li>)}</ul>
            </div>
          </div>
        </CaseSection>

        <!-- 07 research process -->
        <CaseSection {...s.process} note="a living timeline">
          <ProcessTimeline stages={cs.process} />
          <p class="legend meta" aria-hidden="true">
            <span><b class="k done">✓</b> done</span>
            <span><b class="k current">●</b> in progress</span>
            <span><b class="k next">→</b> next</span>
            <span><b class="k planned"></b> planned</span>
          </p>
        </CaseSection>

        <!-- 08 current research questions -->
        <CaseSection {...s.questions} chip="open questions — not conclusions" tone="hypothesis">
          <ol class="rqs">
            {
              cs.researchQuestions.map((q, i) => (
                <li>
                  <span class="meta rq">RQ-{String(i + 1).padStart(2, '0')}</span>
                  <span class="rq-t">{q}</span>
                </li>
              ))
            }
          </ol>
        </CaseSection>

        <!-- 09 competitive research -->
        <CaseSection {...s.competitive}>
          {
            cs.competitors.length === 0 ? (
              <>
                <p class="terminal" role="status">
                  <span aria-hidden="true">$ </span>Competitive analysis in progress.<span class="cursor" aria-hidden="true">▌</span>
                </p>
                <p class="lead">
                  I’ll document existing AAC products here using the same fields for each one, so they can be compared
                  fairly. Nothing has been reviewed yet — below is the empty template.
                </p>
                <CompetitorCard />
              </>
            ) : (
              <div class="comps">
                {cs.competitors.map((c) => (
                  <CompetitorCard item={c} />
                ))}
              </div>
            )
          }
        </CaseSection>

        <!-- 10 research library -->
        <CaseSection {...s.library} note="the desk, currently a little bare">
          <ul class="desk">
            {
              cs.sources.map((src) => (
                <li class="d-book" style={`--r:${tilt(src.id, 2.5)}deg`}>
                  <span class="meta">{src.type}</span>
                  <span class="db-t">{src.title}</span>
                  <span class="db-a">{src.authors}</span>
                  {src.status && <span class="scribble db-s">{src.status}</span>}
                </li>
              ))
            }
            {
              cs.libraryExtras.map((x, i) => (
                <li class={`d-${x.kind}`} style={`--r:${tilt(x.kind + i, 3)}deg`}>
                  {x.kind === 'screenshot' && x.src ? (
                    <figure class="photo">
                      <img src={x.src} alt={x.alt ?? ''} loading="lazy" />
                      <figcaption>{x.text}</figcaption>
                    </figure>
                  ) : x.kind === 'link' && x.href ? (
                    <a href={x.href}>{x.text} ↗</a>
                  ) : (
                    <p>{x.kind === 'quote' ? `“${x.text}”` : x.text}</p>
                  )}
                  {x.source && <span class="meta">— {x.source}</span>}
                </li>
              ))
            }
            {
              cs.librarySlots.map((label, i) => (
                <li class="d-slot" style={`--r:${tilt(label, 2)}deg`}>
                  <span class="meta">empty slot {String(i + 1).padStart(2, '0')}</span>
                  <span>{label}</span>
                  <span class="scribble">to be collected</span>
                </li>
              ))
            }
          </ul>
        </CaseSection>

        <!-- 11 design exploration -->
        <CaseSection {...s.design}>
          <div class="not-yet">
            <p class="ny-h">{cs.designExploration.headline}</p>
            <p class="ny-s">{cs.designExploration.subline}</p>
          </div>
          <div class="frames">
            {
              cs.designExploration.items.length > 0
                ? cs.designExploration.items.map((it) => (
                    <figure class="photo">
                      <img src={it.src} alt={it.alt} loading="lazy" />
                      {it.caption && <figcaption>{it.caption}</figcaption>}
                    </figure>
                  ))
                : cs.designExploration.placeholders.map((label) => (
                    <Placeholder label={label} hint="after the research" />
                  ))
            }
          </div>
        </CaseSection>

        <!-- 12 what I'm learning -->
        <CaseSection {...s.learning}>
          <div class="journal">
            {cs.learning.map((p) => <p>{p}</p>)}
            <p class="scribble sig">— {site.name.toLowerCase()}, {stamp(updated)}</p>
          </div>
        </CaseSection>

        <!-- 13 what's next -->
        <CaseSection {...s.next} note="ticked off as I go">
          <Checklist items={cs.nextSteps} />
        </CaseSection>

        <!-- changelog -->
        <section class="log" aria-labelledby="log-h">
          <h2 id="log-h" class="meta">page log — this page changes as the project does</h2>
          <ul>
            {
              cs.changelog.map((c) => (
                <li>
                  <time class="meta" datetime={c.date}>
                    {stamp(new Date(c.date))}
                  </time>
                  <span>{c.text}</span>
                </li>
              ))
            }
          </ul>
        </section>
      </div>
    </div>

    <ProjectNext next={next} current={entry.id} />
  </article>
</Base>

<style>
  /* ── hero ── */
  .hero {
    padding-block: clamp(2.5rem, 6vw, 5rem) 1rem;
    row-gap: 2.5rem;
    align-items: start;
  }
  .intro {
    grid-column: 1 / span 8;
  }
  .kicker {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    color: var(--accent);
    margin-bottom: 1.2rem;
  }
  h1 {
    font-size: clamp(3.4rem, 2rem + 7vw, 9rem);
    font-style: italic;
    line-height: 0.86;
    letter-spacing: -0.03em;
  }
  .tags {
    margin: 1.2rem 0 0.3rem;
    color: var(--ink);
    font-size: 0.8rem;
  }
  .tags span[aria-hidden] {
    color: var(--accent);
  }
  .context {
    font-family: var(--f-mono);
    font-size: 0.8rem;
    color: var(--ink-soft);
    margin: 0;
  }
  .deck {
    font-size: clamp(1.25rem, 1rem + 0.8vw, 1.7rem);
    line-height: 1.35;
    max-width: 34ch;
    margin-top: 1.6rem;
  }

  /* status card */
  .status {
    grid-column: 9 / span 4;
    position: relative;
    margin-top: 3rem;
    background: var(--paper-3);
    border: 1.5px solid var(--ink);
    padding: 1.3rem 1.2rem 1rem;
    box-shadow: var(--shadow);
    transform: rotate(1.2deg);
    transition: transform 0.5s var(--wobble);
  }
  .status:hover {
    transform: rotate(0);
  }
  .status h2 {
    margin: 0 0 0.7rem;
    color: var(--ink-soft);
  }
  .badge {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: 1.05rem;
    line-height: 1.3;
    padding-bottom: 0.8rem;
    border-bottom: 1px dotted var(--rule);
  }
  .badge strong {
    font-weight: 600;
  }
  .pulse {
    flex: none;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--blue);
    position: relative;
    top: 0.05rem;
  }
  .pulse::after {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 1.5px solid var(--blue);
    animation: pulse 2.2s var(--ease) infinite;
  }
  @keyframes pulse {
    from {
      transform: scale(0.7);
      opacity: 1;
    }
    to {
      transform: scale(1.6);
      opacity: 0;
    }
  }
  .status dl {
    margin: 0;
  }
  .status dl > div {
    display: grid;
    grid-template-columns: 4.2rem 1fr;
    gap: 0.6rem;
    padding: 0.45rem 0;
    font-size: 0.92rem;
    border-bottom: 1px dotted var(--rule);
  }
  .status dt {
    font-family: var(--f-mono);
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-soft);
    padding-top: 0.2rem;
  }
  .status dd {
    margin: 0;
  }
  .bar {
    font-family: var(--f-mono);
    color: var(--blue);
    letter-spacing: 0.1em;
    margin-right: 0.5rem;
  }
  .early {
    position: absolute;
    right: -0.6rem;
    bottom: -1.9rem;
    font-size: 1.35rem;
    transform: rotate(-5deg);
  }
  .hero-media {
    grid-column: 1 / -1;
  }
  .guide {
    grid-column: 1 / -1;
    text-transform: none;
    letter-spacing: 0.02em;
    line-height: 2.2;
    margin: 0;
  }

  /* ── layout: contents rail + sections ── */
  .body {
    border-top: 1px solid var(--ink);
    margin-top: 2rem;
  }
  .toc {
    grid-column: 1 / span 3;
    align-self: start;
    position: sticky;
    top: 1.5rem;
    padding-top: 2.4rem;
  }
  .toc-h {
    margin-bottom: 0.6rem;
  }
  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.95rem;
    line-height: 1.35;
  }
  .toc li {
    padding: 0.18rem 0;
  }
  .toc .meta {
    color: var(--accent);
    margin-right: 0.3rem;
  }
  .sections {
    grid-column: 4 / span 9;
    min-width: 0;
  }

  /* shared bits */
  .lead,
  .caveat {
    max-width: 44em;
    font-size: 1.05rem;
    color: var(--ink-soft);
  }
  .narrow {
    max-width: 38em;
  }

  /* 01 */
  .two {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 2.5rem;
    align-items: start;
  }

  /* 02 tension */
  .tension {
    margin: 2.5rem 0 0;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1rem 1.5rem;
    align-items: center;
  }
  .side {
    border: 1px solid var(--ink);
    padding: 1rem 1.2rem;
    background: var(--paper-3);
    height: 100%;
  }
  .side:last-of-type {
    border-style: dashed;
  }
  .side ul {
    list-style: none;
    margin: 0.6rem 0 0;
    padding: 0;
    font-family: var(--f-display);
    font-size: 1.45rem;
    line-height: 1.2;
  }
  .vs {
    font-family: var(--f-mono);
    font-size: 1.3rem;
    color: var(--accent);
  }
  .tension figcaption {
    grid-column: 1 / -1;
    text-transform: none;
    letter-spacing: 0.02em;
  }

  /* 03 the question */
  .big-q {
    position: relative;
    padding: clamp(1.5rem, 4vw, 3rem) 0 0.5rem clamp(0rem, 4vw, 3rem);
  }
  .qmark {
    position: absolute;
    left: -0.5rem;
    top: -0.5rem;
    font-family: var(--f-display);
    font-style: italic;
    font-size: clamp(9rem, 6rem + 10vw, 16rem);
    line-height: 1;
    color: var(--matcha);
    opacity: 0.35;
    pointer-events: none;
    user-select: none;
  }
  .q {
    position: relative;
    font-family: var(--f-display);
    font-style: italic;
    font-size: clamp(1.9rem, 1.3rem + 2.3vw, 3.3rem);
    line-height: 1.08;
    max-width: 28ch;
    margin: 0;
  }
  .q-note {
    margin-top: 1.4rem;
    font-size: 1.4rem;
  }

  /* 04 sources */
  .sources {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: 1.5rem;
    align-items: stretch;
    margin-top: 1.5rem;
  }

  /* 05 goals */
  .goals {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 2rem;
  }
  .goals li {
    display: grid;
    grid-template-columns: 3.4rem 1fr;
    gap: 0.4rem;
    padding: 0.8rem 0;
    border-bottom: 1px dotted var(--rule);
    font-size: 1.05rem;
    line-height: 1.4;
  }
  .gn {
    color: var(--accent);
    padding-top: 0.25rem;
  }

  /* 06 people */
  .caveat {
    background: var(--sticky);
    color: var(--ink);
    padding: 0.9rem 1.1rem;
    border-left: 3px solid var(--blue);
    margin-bottom: 1.8rem;
  }
  .people {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 1.5rem;
  }
  .who {
    border-top: 1px solid var(--ink);
    padding-top: 0.8rem;
  }
  .who-main {
    font-family: var(--f-display);
    font-size: clamp(1.6rem, 1.3rem + 1vw, 2.2rem);
    line-height: 1.12;
    margin-top: 0.5rem;
  }
  .who ul {
    margin: 0.6rem 0 0;
    padding-left: 1.2rem;
    font-size: 1.05rem;
  }
  .who li + li {
    margin-top: 0.25rem;
  }
  .who li::marker {
    color: var(--accent);
    content: '✿  ';
    font-size: 0.8em;
  }

  /* 07 legend */
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    margin-top: 1.6rem;
    text-transform: lowercase;
  }
  .k {
    display: inline-grid;
    place-items: center;
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    font-size: 0.55rem;
    margin-right: 0.3rem;
    vertical-align: -0.2rem;
    color: var(--paper);
    border: 1.5px dashed var(--ink-faint);
  }
  .k.done {
    background: var(--accent);
    border: 1.5px solid var(--accent);
  }
  .k.current {
    background: var(--blue);
    border: 1.5px solid var(--blue);
  }
  .k.next {
    border: 1.5px solid var(--accent);
    color: var(--accent);
  }

  /* 08 questions */
  .rqs {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .rqs li {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: 0.6rem;
