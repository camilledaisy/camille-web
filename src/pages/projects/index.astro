---
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import ProjectRow from '../../components/ProjectRow.astro';
import { getProjects, tilt } from '../../lib/utils';

/*
 * To add a project: create a new .md file in src/content/projects/
 * and drop an image in public/img/. Copy an existing project to start.
 */
const projects = await getProjects();
const types = [...new Set(projects.map((p) => p.data.type))];
const count = (t: string) => projects.filter((p) => p.data.type === t).length;

// a loose, magazine-y placement that repeats every 5 projects
const layout = [
  { col: '1 / span 5', mt: '0rem' },
  { col: '7 / span 4', mt: '5rem' },
  { col: '2 / span 3', mt: '-3rem' },
  { col: '6 / span 3', mt: '2rem' },
  { col: '10 / span 3', mt: '-5rem' },
];
---

<Base title="Projects" description="Things Daisy has made: UX work, apps, experiments, research, writing, and random creative projects.">
  <div class="wrap">
    <header class="page-head grid">
      <div class="ph">
        <p class="meta">§ the workshop · {projects.length} things</p>
        <h1>Projects</h1>
        <p class="lede">
          Anything I make ends up here — UX work, little apps, research, zines, experiments, and a few things I
          abandoned halfway (those count too).
        </p>
      </div>
      <p class="scribble side" aria-hidden="true">not a portfolio!<br />a junk drawer ♡</p>
    </header>

    <div class="filters" data-filters="#sheet" role="group" aria-label="Filter by type">
      <span class="meta">show:</span>
      <button type="button" data-value="all" aria-pressed="true">everything <sup>{projects.length}</sup></button>
      {
        types.map((t) => (
          <button type="button" data-value={t} aria-pressed="false">
            {t} <sup>{count(t)}</sup>
          </button>
        ))
      }
    </div>

    <ol id="sheet" class="sheet grid">
      {
        projects.map((p, i) => {
          const l = layout[i % layout.length];
          return (
            <li
              class="item"
              data-filter-item={p.data.type}
              style={`grid-column:${l.col};--mt:${l.mt};--rot:${tilt(p.id, 2)}deg`}
            >
              <a href={`/projects/${p.id}`} class="bare" data-cursor="take a look →">
                <div class="img">
                  {p.data.image ? (
                    <img src={p.data.image} alt="" loading="lazy" width="600" height="750" />
                  ) : (
                    <div class="noimg" aria-hidden="true">
                      no image yet
                    </div>
                  )}
                  {p.data.status !== 'finished' && (
                    <span class="stamp" data-status={p.data.status}>
                      {p.data.status}
                    </span>
                  )}
                </div>
                <div class="cap">
                  <span class="meta n">
                    fig. {String(i + 1).padStart(2, '0')} — {p.data.date.getUTCFullYear()}
                  </span>
                  <h2>{p.data.title}</h2>
                  <p>{p.data.summary}</p>
                  <span class="tag">{p.data.type}</span>
                </div>
              </a>
            </li>
          );
        })
      }
    </ol>

    <section class="section" aria-labelledby="index-h">
      <SectionHead num="∞" id="index-h" title="Index of everything" note="for the list people" />
      <ol class="index">
        {projects.map((p, i) => <ProjectRow project={p} index={i} />)}
      </ol>
    </section>
  </div>
</Base>

<style>
  .ph {
    grid-column: 1 / span 8;
  }
  .side {
    grid-column: 10 / span 3;
    align-self: end;
    font-size: 1.8rem;
    transform: rotate(5deg);
  }
  .filters {
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    padding: 0.6rem 0;
    margin-bottom: 3rem;
  }
  .sheet {
    list-style: none;
    margin: 0;
    padding: 0 0 2rem;
    row-gap: 4rem;
    align-items: start;
  }
  .item {
    margin-top: var(--mt);
  }
  .item:nth-child(-n + 2) {
    margin-top: 0;
  }
  .img {
    position: relative;
    background: var(--paper-3);
    padding: 8px;
    border: 1px solid var(--rule);
    box-shadow: var(--shadow);
    transform: rotate(var(--rot));
    transition: transform 0.5s var(--wobble);
  }
  .img img,
  .noimg {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: grayscale(0.25) contrast(1.02);
    transition: filter 0.4s;
  }
  .noimg {
    display: grid;
    place-items: center;
    background: var(--paper-2);
    font-family: var(--f-mono);
    font-size: 0.75rem;
    color: var(--ink-faint);
  }
  .img .stamp {
    position: absolute;
    top: 1rem;
    right: 0.6rem;
    background: var(--paper-3);
  }
  .item a:hover .img,
  .item a:focus-visible .img {
    transform: rotate(calc(var(--rot) * -1)) translateY(-6px);
  }
  .item a:hover img {
    filter: none;
  }
  .cap {
    padding-top: 1rem;
  }
  .cap h2 {
    font-size: clamp(1.7rem, 1.4rem + 1vw, 2.3rem);
    margin: 0.3rem 0 0.4rem;
    transition: color 0.2s;
  }
  .item a:hover h2 {
    color: var(--red);
    font-style: italic;
  }
  .cap p {
    font-size: 0.98rem;
    color: var(--ink-soft);
    line-height: 1.4;
    margin-bottom: 0.4rem;
    max-width: 40ch;
  }
  .index {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (max-width: 860px) {
    .side {
      display: none;
    }
    .sheet {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .sheet > .item {
      grid-column: auto !important;
      margin-top: 0;
    }
  }
  @media (max-width: 520px) {
    .sheet {
      grid-template-columns: 1fr;
    }
  }
</style>
