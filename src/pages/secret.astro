---
import Base from '../layouts/Base.astro';
---

<Base title="The secret garden" noindex>
  <div class="wrap secret">
    <p class="meta">§ ??? · you found it</p>
    <h1>The secret garden</h1>
    <pre aria-hidden="true">{String.raw`
                  _    _
       .-.       (_)  (_)      .-.
      (   )  @  \|/    \|/  @ (   )
       '-'  \|/  |  __  |  \|/ '-'
        |    |   | (__) |   |   |
   ^^^^^|^^^^|^^^|^^||^^|^^^|^^^|^^^^^
          a gnome lives here.  shh.
`}</pre>
    <div class="prose">
      <p>
        Hello, curious one. This is the room at the back of the house. There’s nothing here yet except a gnome and my
        gratitude that you looked.
      </p>
      <p>Some other secrets, since you’re here:</p>
      <ul>
        <li>↑ ↑ ↓ ↓ ← → ← → B A (then do it again to come back)</li>
        <li>click the big name on the homepage a few times</li>
        <li>leave this tab and look at its title</li>
        <li>open the browser console</li>
      </ul>
      <p><em>(Use this page for anything — unfinished ideas, a guestbook, a playlist, a letter to future you.)</em></p>
    </div>
  </div>
</Base>

<style>
  .secret {
    max-width: 48rem;
    padding-block: 4rem;
  }
  h1 {
    font-size: clamp(3rem, 2rem + 5vw, 7rem);
    font-style: italic;
    color: var(--green);
    margin: 0.5rem 0 1rem;
  }
  pre {
    font-family: var(--f-mono);
    color: var(--green);
    font-size: clamp(0.7rem, 0.5rem + 0.8vw, 1rem);
    overflow: hidden;
  }
</style>
